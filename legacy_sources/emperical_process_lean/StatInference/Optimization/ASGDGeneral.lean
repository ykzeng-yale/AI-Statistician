        atTop (𝓝 0)) :
    TendstoInMeasure P
      (fun N ω => chewi128ASGDZetaContribution A Ainv h zeta N ω)
      atTop (fun _ => 0) := by
  refine
    chewi128ASGDZetaContribution_tendstoInMeasure_zero_of_source_l1_and_uniform_coeff_bound
      A Ainv h zeta K hK_nonneg hcoeff_bound hzeta_int
      hZetaContribution_int ?_
  refine
    tendsto_of_tendsto_of_tendsto_of_le_of_le'
