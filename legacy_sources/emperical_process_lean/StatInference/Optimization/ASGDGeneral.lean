/--
Expected-norm row bound for the Chewi 12.8 `zeta` contribution under a
uniform residual-coefficient bound.  This is the source proof's step that
reduces the extra residual to `(sqrt N)^{-1} sum E ||zeta_k||`.
-/
theorem chewi128ASGDZetaContribution_integral_norm_le_source_l1_row_of_uniform_coeff_bound
    {Ω E : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (A Ainv : E →L[ℝ] E) (h : ℕ -> ℝ)
    (zeta : ℕ -> Ω -> E) (K : ℝ)
    (hK_nonneg : 0 ≤ K)
    (hcoeff_bound : ∀ N k, k ∈ Finset.Ico 1 N ->
      ‖chewi123SourceNoiseCoefficient A h k N - Ainv‖ ≤ K)
    (hzeta_int : ∀ k, Integrable (fun ω => ‖zeta k ω‖) P)
    (hZetaContribution_int :
      ∀ N,
        Integrable
          (fun ω => ‖chewi128ASGDZetaContribution A Ainv h zeta N ω‖) P)
    (N : ℕ) :
    ∫ ω, ‖chewi128ASGDZetaContribution A Ainv h zeta N ω‖ ∂P ≤
      (2 * ‖Ainv‖ + K) *
        (‖(Real.sqrt (N : ℝ))⁻¹‖ *
          ∑ k ∈ Finset.range N, ∫ ω, ‖zeta k ω‖ ∂P) := by
  let C : ℝ := 2 * ‖Ainv‖ + K
  let c : ℝ := ‖(Real.sqrt (N : ℝ))⁻¹‖
  have hsum_int :
      Integrable (fun ω => ∑ k ∈ Finset.range N, ‖zeta k ω‖) P := by
    refine integrable_finsetSum (Finset.range N) ?_
    intro k _hk
    exact hzeta_int k
  have hrow_int :
      Integrable
        (fun ω => C * (c * ∑ k ∈ Finset.range N, ‖zeta k ω‖)) P := by
    simpa [C, c, mul_assoc, mul_comm, mul_left_comm] using
      ((hsum_int.const_mul c).const_mul C)
  have hpoint :
      (fun ω =>
        ‖chewi128ASGDZetaContribution A Ainv h zeta N ω‖) ≤ᵐ[P]
      fun ω => C * (c * ∑ k ∈ Finset.range N, ‖zeta k ω‖) := by
    exact Eventually.of_forall fun ω => by
      simpa [C, c, mul_assoc, mul_comm, mul_left_comm] using
        chewi128ASGDZetaContribution_norm_le_source_row_of_uniform_coeff_bound
          A Ainv h zeta K hK_nonneg hcoeff_bound N ω
  calc
    ∫ ω, ‖chewi128ASGDZetaContribution A Ainv h zeta N ω‖ ∂P ≤
        ∫ ω, C * (c * ∑ k ∈ Finset.range N, ‖zeta k ω‖) ∂P :=
      integral_mono_ae (hZetaContribution_int N) hrow_int hpoint
    _ = C * (c * ∑ k ∈ Finset.range N, ∫ ω, ‖zeta k ω‖ ∂P) := by
      rw [integral_const_mul]
      rw [integral_const_mul]
      rw [integral_finsetSum]
      intro k _hk
      exact hzeta_int k
    _ = (2 * ‖Ainv‖ + K) *
        (‖(Real.sqrt (N : ℝ))⁻¹‖ *
          ∑ k ∈ Finset.range N, ∫ ω, ‖zeta k ω‖ ∂P) := by
      simp [C, c]

