/--
Markov/L1 handoff: convergence to zero in expected norm implies convergence in
measure.  This is the reusable probability step behind Chewi's residual
estimate in Theorem 12.8.
-/
theorem tendstoInMeasure_zero_of_integral_norm_tendsto_zero
    {Ω E : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    [IsFiniteMeasure P] [SeminormedAddCommGroup E]
    {X : ℕ -> Ω -> E}
    (hX_int : ∀ n, Integrable (fun ω => ‖X n ω‖) P)
    (hL1 : Tendsto (fun n => ∫ ω, ‖X n ω‖ ∂P) atTop (𝓝 (0 : ℝ))) :
    TendstoInMeasure P X atTop (fun _ => 0) := by
  rw [MeasureTheory.tendstoInMeasure_iff_measureReal_norm]
  intro ε hε
  have hε_nonneg : 0 ≤ ε := le_of_lt hε
  have hupper :
      ∀ n,
        P.real {ω | ε ≤ ‖X n ω - (0 : E)‖} ≤
          ε⁻¹ * ∫ ω, ‖X n ω‖ ∂P := by
    intro n
    have hmarkov :
        ε * P.real {ω | ε ≤ ‖X n ω - (0 : E)‖} ≤
          ∫ ω, ‖X n ω‖ ∂P := by
      simpa [sub_zero] using
        MeasureTheory.mul_meas_ge_le_integral_of_nonneg
          (μ := P) (f := fun ω => ‖X n ω‖)
          (Eventually.of_forall fun _ => norm_nonneg _)
          (hX_int n) ε
    calc
      P.real {ω | ε ≤ ‖X n ω - (0 : E)‖} =
          ε⁻¹ * (ε * P.real {ω | ε ≤ ‖X n ω - (0 : E)‖}) := by
        field_simp [ne_of_gt hε]
      _ ≤ ε⁻¹ * ∫ ω, ‖X n ω‖ ∂P :=
        mul_le_mul_of_nonneg_left hmarkov (inv_nonneg.mpr hε_nonneg)
  have hright :
      Tendsto (fun n => ε⁻¹ * ∫ ω, ‖X n ω‖ ∂P) atTop (𝓝 0) := by
    simpa using hL1.const_mul ε⁻¹
  exact
    tendsto_of_tendsto_of_tendsto_of_le_of_le
      tendsto_const_nhds hright
      (fun _ => MeasureTheory.measureReal_nonneg)
      hupper

