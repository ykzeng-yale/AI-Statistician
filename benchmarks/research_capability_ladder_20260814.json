  "evidence_dimensions": [
    {
      "id": "source_replication",
      "meaning": "Exact rerun of supplied immutable author code and data.",
      "allowed_requirements": ["required", "optional", "not_applicable"]
    },
    {
      "id": "theory",
      "meaning": "Definitions, assumptions, equation and claim lineage, counterchecks, and independent review.",
      "allowed_requirements": ["required", "optional", "not_applicable"]
    },
    {
      "id": "scientific_code",
      "meaning": "Model-authored Python or R source executed and independently reviewed against current theory.",
      "allowed_requirements": ["required", "optional", "not_applicable"]
    },
    {
      "id": "empirical",
      "meaning": "Frozen confirmatory protocol, fresh outcomes, and reported Monte Carlo uncertainty.",
      "allowed_requirements": ["required", "optional", "not_applicable"]
    },
    {
      "id": "formal",
      "meaning": "Exact target-bound Lean source, semantic review, and local kernel evidence.",
      "allowed_requirements": ["required", "optional", "not_applicable"]
    },
    {
      "id": "novelty",
      "meaning": "Comparison against the frozen permitted source horizon.",
      "allowed_requirements": ["required", "optional", "not_applicable"]
    },
    {
      "id": "unresolved_gaps",
      "meaning": "Explicit evidence-bound defects and unclosed claims.",
      "allowed_requirements": ["required"]
    }
  ],
  "progressive_workflow": [
    {
      "id": "source_scout",
      "starts_when": "external sources are permitted by task policy",
      "outputs": ["source snapshot refs", "paper-code-data availability", "replication plan"]
    },
    {
      "id": "exact_replication",
      "starts_when": "pinned public code and data are supplied",
      "outputs": ["environment lock", "raw rerun observation", "published-output comparison"]
    },
    {
      "id": "iterative_theory",
      "starts_when": "the research question and source policy are frozen",
      "outputs": ["definition ledger", "assumption ledger", "equation lineage", "claim DAG", "counterchecks", "gap ledger"]
    },
    {
      "id": "exploratory_scientific_work",
      "starts_when": "estimand, DGP, consumed claim, and procedure interface are executable",
      "outputs": ["model-authored source", "raw execution feedback", "non-confirmatory diagnostics"]
    },
    {
      "id": "stable_theory_checkpoint",
      "starts_when": "independent review accepts the current theory and source semantics",
      "outputs": ["review artifact", "immutable parent hashes", "remaining gaps"]
    },
    {
      "id": "confirmatory_execution",
      "starts_when": "metric contract, source review, cohort, and simulation precision rule are frozen",
      "outputs": ["fresh blinded outcomes", "Monte Carlo uncertainty", "requirement verdicts"]
    },
    {
      "id": "deep_formalization",
      "starts_when": "the theorem statement is stable or task scheduling is proof_first",
      "outputs": ["formal RAG trace", "raw Lean observations", "kernel evidence or formal gap"]
    },
    {
      "id": "final_critic",
      "starts_when": "all required lanes are terminal",
      "outputs": ["per-dimension status", "evidence refs", "unresolved gaps", "honest overall disposition"]
    }
  ],
  "formalization_contract": {
    "policies": ["required", "optional", "advisory"],
    "schedules": ["proof_first", "simulation_first", "dual_track"],
    "light_formal_scout_may_run_in_parallel": true,
    "deep_proving_default_start": "after independent statement-stability review",
    "optional_gap_blocks_nonformal_dimensions": false,
    "required_gap_blocks_task_completion": true,
    "nonproof_evidence_may_be_promoted_to_proof": false
  },
  "simulation_precision_contract": {
    "universal_fixed_replication_count": null,
    "allowed_pre_outcome_budget_rules": [
      "target Monte Carlo standard error",
      "target confidence interval width",
      "target power or rare-event precision",
      "fixed resource budget with reported uncertainty"
    ],
    "exploratory_runs_are_confirmatory": false,
    "confirmatory_rule_frozen_before_outcomes": true,
    "favorable_outcome_stopping_forbidden": true
  },
  "levels": [
