diff --git a/src/scripts/lib/container_agent.sh b/src/scripts/lib/container_agent.sh
index c52dd47..58929a6 100644
--- a/src/scripts/lib/container_agent.sh
+++ b/src/scripts/lib/container_agent.sh
@@ -139,6 +139,42 @@ validate_agent_reasoning_effort() {
   fi
 }
 
+validate_native_api_author() {
+  local containerize="$1" harness="$2" profile_set="$3" effort_set="$4" model="$5"
+  if [ "$containerize" -ne 0 ]; then
+    echo "local-api does not support --containerize; use native execution" >&2
+    return 1
+  fi
+  if [ "$harness" -ne 1 ]; then
+    echo "local-api requires --harness-evaluated-attempt (source authoring only)" >&2
+    return 1
+  fi
+  if [ "$profile_set" -eq 1 ]; then
+    echo "local-api does not support --agent-profile/--profile" >&2
+    return 1
+  fi
+  if [ "$effort_set" -eq 1 ]; then
+    echo "local-api does not support --reasoning-effort; reasoning belongs to the pinned deployment" >&2
+    return 1
+  fi
+  if [ -z "${model//[[:space:]]/}" ]; then
+    echo "local-api requires an explicit --agent-model/--model" >&2
+    return 1
+  fi
+  if [[ "${AI_STATISTICIAN_API_PYTHON:-}" != /* ]] \
+    || [ ! -f "${AI_STATISTICIAN_API_PYTHON:-}" ] \
+    || [ ! -x "${AI_STATISTICIAN_API_PYTHON:-}" ]; then
+    echo "local-api requires AI_STATISTICIAN_API_PYTHON to be an absolute executable file" >&2
+    return 1
+  fi
+  if [[ "${AI_STATISTICIAN_API_ENTRYPOINT:-}" != /* ]] \
+    || [ ! -f "${AI_STATISTICIAN_API_ENTRYPOINT:-}" ] \
+    || [ ! -r "${AI_STATISTICIAN_API_ENTRYPOINT:-}" ]; then
+    echo "local-api requires AI_STATISTICIAN_API_ENTRYPOINT to be an absolute readable file" >&2
+    return 1
+  fi
+}
