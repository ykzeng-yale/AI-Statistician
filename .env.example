# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; `.env.example` is safe to commit.

# Live LLM default: Anthropic Claude API, generator-only.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Keep the provider on Anthropic for normal live runs. OpenAI/static are explicit
# overrides; Codex/Codex exec are not accepted as pure LLM providers.
AI_STATISTICIAN_LLM_PROVIDER=anthropic

# Current pinned Claude API defaults, source-checked 2026-06-13.
# Leave AI_STATISTICIAN_LLM_MODEL unset in normal runs so Haiku/Sonnet/Opus
# routing does not collapse to one global model.
AI_STATISTICIAN_CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001
AI_STATISTICIAN_CLAUDE_SONNET_MODEL=claude-sonnet-4-6
AI_STATISTICIAN_CLAUDE_OPUS_MODEL=claude-opus-4-8

# Optional Sonnet-tier compatibility override only. Do not use this to force
# cheaper helper stages onto Sonnet; set the tier-specific variables above.
# AI_STATISTICIAN_ANTHROPIC_MODEL=claude-sonnet-4-6

# Axiom Math AXLE API key (used by `AxleClient(api_key=...)`).
AXLE_API_KEY=pk_...
