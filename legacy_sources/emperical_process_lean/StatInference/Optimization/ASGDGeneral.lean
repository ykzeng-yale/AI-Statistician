/--
If a deterministic row has order `N^beta` with `beta < 1/2`, then multiplying
by `1 / sqrt N` sends it to zero.  This is the finite-power analytic gate for
Chewi's `gamma > 1/2` residual estimate.
-/
theorem chewi128_sqrt_inv_mul_power_tendsto_zero
    (D beta : ℝ) (hbeta_lt : beta < (1 : ℝ) / 2) :
    Tendsto
      (fun N : ℕ => ‖(Real.sqrt (N : ℝ))⁻¹‖ * (D * (N : ℝ) ^ beta))
      atTop (𝓝 0) := by
  have hpow :
      Tendsto (fun x : ℝ => x ^ (beta - (1 : ℝ) / 2)) atTop (𝓝 0) := by
    simpa [sub_eq_add_neg] using
      (tendsto_rpow_neg_atTop
        (show 0 < (1 : ℝ) / 2 - beta by linarith))
  have hnat :
      Tendsto
        (fun N : ℕ => (N : ℝ) ^ (beta - (1 : ℝ) / 2))
        atTop (𝓝 0) :=
    hpow.comp tendsto_natCast_atTop_atTop
  have hD :
      Tendsto
        (fun N : ℕ => D * (N : ℝ) ^ (beta - (1 : ℝ) / 2))
        atTop (𝓝 0) := by
    simpa using
      (tendsto_const_nhds.mul hnat :
        Tendsto
          (fun N : ℕ => D * (N : ℝ) ^ (beta - (1 : ℝ) / 2))
          atTop (𝓝 (D * 0)))
  refine hD.congr' ?_
  refine eventually_atTop.2 ⟨1, ?_⟩
  intro N hN
  have hNpos : 0 < (N : ℝ) := by exact_mod_cast hN
  have hNnonneg : 0 ≤ (N : ℝ) := le_of_lt hNpos
  have hsqrt_nonneg : 0 ≤ (Real.sqrt (N : ℝ))⁻¹ :=
    inv_nonneg.mpr (Real.sqrt_nonneg _)
  symm
  calc
    ‖(Real.sqrt (N : ℝ))⁻¹‖ * (D * (N : ℝ) ^ beta)
        = (Real.sqrt (N : ℝ))⁻¹ * (D * (N : ℝ) ^ beta) := by
          rw [Real.norm_eq_abs, abs_of_nonneg hsqrt_nonneg]
    _ = ((N : ℝ) ^ ((1 : ℝ) / 2))⁻¹ * (D * (N : ℝ) ^ beta) := by
          rw [Real.sqrt_eq_rpow]
    _ = (N : ℝ) ^ (-((1 : ℝ) / 2)) * (D * (N : ℝ) ^ beta) := by
          rw [← Real.rpow_neg hNnonneg ((1 : ℝ) / 2)]
    _ = D * ((N : ℝ) ^ beta * (N : ℝ) ^ (-((1 : ℝ) / 2))) := by ring
    _ = D * (N : ℝ) ^ (beta - (1 : ℝ) / 2) := by
          rw [← Real.rpow_add hNpos]
          ring_nf

/--
Squeeze form of `chewi128_sqrt_inv_mul_power_tendsto_zero`: an eventually
nonnegative row bounded by `D * N^beta`, `beta < 1/2`, is `o(sqrt N)`.
-/
theorem chewi128_sqrt_inv_row_tendsto_zero_of_power_bound
    (R : ℕ -> ℝ) {D beta : ℝ}
    (hbeta_lt : beta < (1 : ℝ) / 2)
    (hR_nonneg : ∀ᶠ N in atTop, 0 ≤ R N)
    (hR_bound : ∀ᶠ N in atTop, R N ≤ D * (N : ℝ) ^ beta) :
    Tendsto
      (fun N : ℕ => ‖(Real.sqrt (N : ℝ))⁻¹‖ * R N)
      atTop (𝓝 0) := by
  have hupper :
      Tendsto
        (fun N : ℕ => ‖(Real.sqrt (N : ℝ))⁻¹‖ * (D * (N : ℝ) ^ beta))
        atTop (𝓝 0) :=
    chewi128_sqrt_inv_mul_power_tendsto_zero D beta hbeta_lt
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hupper ?_ ?_
  · filter_upwards [hR_nonneg] with N hRN
    exact mul_nonneg (norm_nonneg _) hRN
  · filter_upwards [hR_bound] with N hRN
    exact mul_le_mul_of_nonneg_left hRN (norm_nonneg _)

/--
Finite power-row estimate for the Chewi 12.8 residual source.  It packages
the existing integral-test bound with the one-based `k + 1` indexing used by
the `zeta` row.
-/
theorem chewi128_sum_range_one_add_rpow_neg_le_power
    {C gamma : ℝ} (hC_nonneg : 0 ≤ C)
    (hgamma_pos : 0 < gamma) (hgamma_lt_one : gamma < 1)
    {N : ℕ} (hN : 1 ≤ N) :
    (∑ k ∈ Finset.range N,
        C * (((k + 1 : ℕ) : ℝ) ^ (-gamma))) ≤
      (C * ((1 + (1 - gamma)⁻¹) * (2 : ℝ) ^ (1 - gamma))) *
        (N : ℝ) ^ (1 - gamma) := by
  let beta : ℝ := 1 - gamma
  have hbeta_pos : 0 < beta := by
    dsimp [beta]
    linarith
  have hbeta_lt : beta < 1 := by
    dsimp [beta]
    linarith
  have hsum_shift :
      (∑ k ∈ Finset.range N,
          (((k + 1 : ℕ) : ℝ) ^ (-gamma))) =
        ∑ j ∈ Finset.Ico 1 (N + 1), (j : ℝ) ^ (-gamma) := by
    rw [Finset.sum_Ico_eq_sum_range]
    have hlen : N + 1 - 1 = N := by omega
    rw [hlen]
    refine Finset.sum_congr rfl ?_
    intro k _hk
    congr 1
    ring_nf
  have houter_raw :=
    chewi125_sum_Ico_rpow_gamma_sub_one_le
      (gamma := beta) hbeta_pos hbeta_lt
      (N := N + 1) (by omega : 1 ≤ N + 1)
  have houter :
      (∑ j ∈ Finset.Ico 1 (N + 1), (j : ℝ) ^ (-gamma)) ≤
        (1 + (1 - gamma)⁻¹) * ((N + 1 : ℕ) : ℝ) ^ (1 - gamma) := by
    simpa [beta, sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using houter_raw
  have hN1_le_twoN : (((N + 1 : ℕ) : ℝ)) ≤ 2 * (N : ℝ) := by
    have hN_real : (1 : ℝ) ≤ (N : ℝ) := by exact_mod_cast hN
    norm_num
    nlinarith
  have hpow_le :
      (((N + 1 : ℕ) : ℝ) ^ (1 - gamma)) ≤
        ((2 : ℝ) ^ (1 - gamma)) * (N : ℝ) ^ (1 - gamma) := by
    have hmono :=
      Real.rpow_le_rpow
        (Nat.cast_nonneg (N + 1)) hN1_le_twoN
        (show 0 ≤ 1 - gamma by linarith)
    have htwo_nonneg : (0 : ℝ) ≤ 2 := by norm_num
    have hN_nonneg : 0 ≤ (N : ℝ) := Nat.cast_nonneg N
    calc
      (((N + 1 : ℕ) : ℝ) ^ (1 - gamma)) ≤
          (2 * (N : ℝ)) ^ (1 - gamma) := hmono
      _ = ((2 : ℝ) ^ (1 - gamma)) * (N : ℝ) ^ (1 - gamma) := by
          rw [Real.mul_rpow htwo_nonneg hN_nonneg]
  have hfactor_nonneg : 0 ≤ 1 + (1 - gamma)⁻¹ := by
    exact add_nonneg zero_le_one (inv_nonneg.mpr (le_of_lt hbeta_pos))
  have hsum_bound :
      (∑ j ∈ Finset.Ico 1 (N + 1), (j : ℝ) ^ (-gamma)) ≤
        (1 + (1 - gamma)⁻¹) *
          (((2 : ℝ) ^ (1 - gamma)) * (N : ℝ) ^ (1 - gamma)) := by
    exact houter.trans
      (mul_le_mul_of_nonneg_left hpow_le hfactor_nonneg)
  calc
    (∑ k ∈ Finset.range N,
        C * (((k + 1 : ℕ) : ℝ) ^ (-gamma)))
        = C * ∑ k ∈ Finset.range N,
            (((k + 1 : ℕ) : ℝ) ^ (-gamma)) := by
          rw [Finset.mul_sum]
    _ = C * ∑ j ∈ Finset.Ico 1 (N + 1), (j : ℝ) ^ (-gamma) := by
          rw [hsum_shift]
    _ ≤ C *
        ((1 + (1 - gamma)⁻¹) *
          (((2 : ℝ) ^ (1 - gamma)) * (N : ℝ) ^ (1 - gamma))) :=
          mul_le_mul_of_nonneg_left hsum_bound hC_nonneg
    _ = (C * ((1 + (1 - gamma)⁻¹) * (2 : ℝ) ^ (1 - gamma))) *
        (N : ℝ) ^ (1 - gamma) := by ring

/--
Closed finite-power row for Chewi's `gamma > 1/2` residual regime.
-/
theorem chewi128_power_source_row_tendsto_zero_of_gamma_gt_half
    (C gamma : ℝ) (hC_nonneg : 0 ≤ C)
    (hgamma_half : (1 : ℝ) / 2 < gamma)
    (hgamma_lt_one : gamma < 1) :
    Tendsto
      (fun N : ℕ =>
        ‖(Real.sqrt (N : ℝ))⁻¹‖ *
          ∑ k ∈ Finset.range N,
            C * (((k + 1 : ℕ) : ℝ) ^ (-gamma)))
      atTop (𝓝 0) := by
  let D : ℝ := C * ((1 + (1 - gamma)⁻¹) * (2 : ℝ) ^ (1 - gamma))
  have hbeta_lt : 1 - gamma < (1 : ℝ) / 2 := by linarith
  refine
    chewi128_sqrt_inv_row_tendsto_zero_of_power_bound
      (fun N : ℕ =>
        ∑ k ∈ Finset.range N,
          C * (((k + 1 : ℕ) : ℝ) ^ (-gamma)))
      (D := D) (beta := 1 - gamma) hbeta_lt ?_ ?_
  · exact Eventually.of_forall fun N =>
      Finset.sum_nonneg fun k _hk =>
        mul_nonneg hC_nonneg
          (Real.rpow_nonneg (Nat.cast_nonneg (k + 1)) (-gamma))
  · refine eventually_atTop.2 ⟨1, ?_⟩
    intro N hN
    simpa [D] using
      chewi128_sum_range_one_add_rpow_neg_le_power
        (C := C) (gamma := gamma) hC_nonneg
        (by linarith : 0 < gamma) hgamma_lt_one hN

