# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; `.env.example` is safe to commit.
# Runtime reads `.env`; this tracked template must contain placeholders only.

# Live LLM default: Anthropic Claude API, generator-only.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=replace_with_anthropic_api_key

# Keep the provider on Anthropic for normal live runs. OpenAI/static are explicit
# overrides; Codex/Codex exec are not accepted as pure LLM providers.
AI_STATISTICIAN_LLM_PROVIDER=anthropic

# Current pinned Claude API defaults, source-checked 2026-08-02.
# Leave AI_STATISTICIAN_LLM_MODEL unset in normal runs so Haiku/Sonnet routing
# does not collapse to one global model. Live Anthropic calls are capped at Sonnet.
AI_STATISTICIAN_CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001
AI_STATISTICIAN_CLAUDE_SONNET_MODEL=claude-sonnet-5

# Optional native extended thinking for pinned Haiku retained tool workspaces.
# Freeze before a NEW run: 0 disables; enabled budget must be >=1024 and below
# every affected request's max_tokens. Total output limits are not increased.
# Enables automatic tool selection; plain-text stopping still needs explicit resume.
# Tool-free Architect/gold generation is unchanged. Never change a consumed run.
AI_STATISTICIAN_HAIKU_TOOL_THINKING_BUDGET_TOKENS=0

# Optional Sonnet-tier compatibility override only. Do not use this to force
# cheaper helper stages onto Sonnet; set the tier-specific variables above.
# AI_STATISTICIAN_ANTHROPIC_MODEL=claude-sonnet-5

# Optional pinned AI4SLT retrieval resources. Standard ~/.codex/external paths
# are auto-discovered when these are unset.
# AI_STATISTICIAN_AI4SLT_PREMISE_CORPUS=/path/to/corpus.jsonl
# AI_STATISTICIAN_AI4SLT_PROOF_STATE_TRACES=/path/to/novel-train.jsonl
# AI_STATISTICIAN_AI4SLT_PROOF_STATE_TRACE_INDEX=/path/to/novel-train.sqlite
# AI_STATISTICIAN_AI4SLT_PROOF_STATE_TRACE_ENABLED=false

# Axiom Math AXLE API key (used by `AxleClient(api_key=...)`).
AXLE_API_KEY=replace_with_axle_api_key
