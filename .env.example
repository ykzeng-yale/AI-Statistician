# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; `.env.example` is safe to commit.

# Anthropic Claude API key (used by `anthropic.Anthropic()` in stat_agent.py,
# stat_research_agent.py, formal_proof_eval.py). Get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Axiom Math AXLE API key (used by `AxleClient(api_key=...)`).
AXLE_API_KEY=pk_...
