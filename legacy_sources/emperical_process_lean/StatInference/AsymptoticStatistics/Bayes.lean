/--
The posterior tail integral appearing in display (10.9).  The set
`tailSet n` represents `C_nᶜ`, while `tailWeight` is the nonnegative
function `f` or a loss envelope.
-/
def vaart1998_bayesPosteriorTailLIntegral
    {Ω H : Type*} [MeasurableSpace Ω] [MeasurableSpace H]
    (posteriorKernel : ℕ -> Kernel Ω H) (tailSet : ℕ -> Set H)
    (tailWeight : H -> ℝ≥0∞) :
    ℕ -> Ω -> ℝ≥0∞ :=
  fun n ω =>
    ∫⁻ h, (tailSet n).indicator tailWeight h ∂posteriorKernel n ω

/--
Chapter 10 posterior-tail truncation source.

This is the source-shaped form of display (10.9): the posterior integral of
the tail part `f 1_{C_nᶜ}` is represented by a real-valued display and is
assumed to be `o_{P_n}(1)`.
-/
structure Vaart1998BayesPosteriorTailTruncationSource
    {Ω H : Type*} [MeasurableSpace Ω] [MeasurableSpace H]
    (P : ℕ -> Measure Ω) [∀ n, IsProbabilityMeasure (P n)] where
  /-- Posterior laws of the local parameter. -/
  posteriorKernel : ℕ -> Kernel Ω H
  /-- Posterior laws are Markov kernels. -/
  posteriorKernel_isMarkov : ∀ n, IsMarkovKernel (posteriorKernel n)
  /-- Tail sets, typically complements of balls `C_nᶜ`. -/
  tailSet : ℕ -> Set H
  /-- Nonnegative tail weight, e.g. a subpolynomial envelope. -/
  tailWeight : H -> ℝ≥0∞
  /-- Real-valued display of the posterior tail integral. -/
  tailIntegralDisplay : ℕ -> Ω -> ℝ
  /-- The displayed tail integral is nonnegative. -/
  tailIntegralDisplay_nonneg : ∀ n ω, 0 ≤ tailIntegralDisplay n ω
  /-- Display (10.9): the posterior tail integral is negligible in probability. -/
  tailIntegralDisplay_convergesInProbability :
    Vaart1998MeasureSeqConvergesInProbabilityToZero P tailIntegralDisplay

/--
The posterior tail integral as an extended nonnegative integral.
-/
def Vaart1998BayesPosteriorTailTruncationSource.tailLIntegral
    {Ω H : Type*} [MeasurableSpace Ω] [MeasurableSpace H]
    {P : ℕ -> Measure Ω} [∀ n, IsProbabilityMeasure (P n)]
    (S : Vaart1998BayesPosteriorTailTruncationSource (H := H) P) :
    ℕ -> Ω -> ℝ≥0∞ :=
  vaart1998_bayesPosteriorTailLIntegral S.posteriorKernel
    S.tailSet S.tailWeight

/--
The convergence-in-probability certificate for the tail display.
-/
theorem Vaart1998BayesPosteriorTailTruncationSource.convergesInProbability
    {Ω H : Type*} [MeasurableSpace Ω] [MeasurableSpace H]
    {P : ℕ -> Measure Ω} [∀ n, IsProbabilityMeasure (P n)]
    (S : Vaart1998BayesPosteriorTailTruncationSource (H := H) P) :
    Vaart1998MeasureSeqConvergesInProbabilityToZero P
      S.tailIntegralDisplay :=
  S.tailIntegralDisplay_convergesInProbability

/--
The posterior tail display is stochastically bounded.
-/
theorem Vaart1998BayesPosteriorTailTruncationSource.tailIntegralDisplay_stochasticallyBounded
    {Ω H : Type*} [MeasurableSpace Ω] [MeasurableSpace H]
    {P : ℕ -> Measure Ω} [∀ n, IsProbabilityMeasure (P n)]
    (S : Vaart1998BayesPosteriorTailTruncationSource (H := H) P) :
    Vaart1998MeasureSeqStochasticBounded P S.tailIntegralDisplay :=
  vaart1998_measureSeqStochasticBounded_of_convergesInProbabilityToZero
    S.tailIntegralDisplay_convergesInProbability

/--
Chapter 10 risk-process tail approximation source.

The full posterior-risk process `Z_n` and a truncated version `Z_{n,M_n}`
are recorded together with a pointwise bound of their difference by the
posterior tail display from (10.9).
-/
structure Vaart1998BayesRiskProcessTailApproximationSource
    {Ω H R : Type*} [MeasurableSpace Ω] [MeasurableSpace H]
    [SeminormedAddCommGroup R]
    (P : ℕ -> Measure Ω) [∀ n, IsProbabilityMeasure (P n)] where
  /-- Posterior-tail negligibility source. -/
  tailSource : Vaart1998BayesPosteriorTailTruncationSource
    (H := H) P
  /-- Full posterior-risk process `Z_n`. -/
  riskProcess : ℕ -> Ω -> R
  /-- Truncated posterior-risk process `Z_{n,M_n}`. -/
  truncatedRiskProcess : ℕ -> Ω -> R
  /-- The truncation error is bounded by the posterior tail display. -/
  riskProcess_sub_truncated_norm_le_tailIntegral :
    ∀ n ω,
      ‖riskProcess n ω - truncatedRiskProcess n ω‖ ≤
        ‖tailSource.tailIntegralDisplay n ω‖

/--
The full and truncated posterior-risk processes differ by `o_{P_n}(1)`.
-/
theorem Vaart1998BayesRiskProcessTailApproximationSource.riskProcess_sub_truncated_convergesInProbability
    {Ω H R : Type*} [MeasurableSpace Ω] [MeasurableSpace H]
    [SeminormedAddCommGroup R]
    {P : ℕ -> Measure Ω} [∀ n, IsProbabilityMeasure (P n)]
    (S : Vaart1998BayesRiskProcessTailApproximationSource (H := H)
      (R := R) P) :
    Vaart1998MeasureSeqConvergesInProbabilityToZero P
      (fun n ω => S.riskProcess n ω - S.truncatedRiskProcess n ω) :=
  vaart1998_measureSeqConvergesInProbabilityToZero_of_norm_le
    S.riskProcess_sub_truncated_norm_le_tailIntegral
    S.tailSource.tailIntegralDisplay_convergesInProbability

/--
The truncation error between the full and truncated risk processes is
stochastically bounded.
-/
theorem Vaart1998BayesRiskProcessTailApproximationSource.riskProcess_sub_truncated_stochasticallyBounded
    {Ω H R : Type*} [MeasurableSpace Ω] [MeasurableSpace H]
    [SeminormedAddCommGroup R]
    {P : ℕ -> Measure Ω} [∀ n, IsProbabilityMeasure (P n)]
    (S : Vaart1998BayesRiskProcessTailApproximationSource (H := H)
      (R := R) P) :
    Vaart1998MeasureSeqStochasticBounded P
      (fun n ω => S.riskProcess n ω - S.truncatedRiskProcess n ω) :=
  vaart1998_measureSeqStochasticBounded_of_convergesInProbabilityToZero
    S.riskProcess_sub_truncated_convergesInProbability

/--
Chapter 10 compact risk-process convergence source.

This packages the final risk-process step in Theorem 10.8.  A truncated
process converges weakly on the compact index set, the full/truncated
difference is negligible by the posterior-tail source, and a supplied
Slutsky/diagonal-transfer certificate upgrades the truncated convergence to
the full posterior-risk process.
-/
structure Vaart1998BayesCompactRiskProcessConvergenceSource
    {Ω ΩLimit H R : Type*} [MeasurableSpace Ω]
    [MeasurableSpace ΩLimit] [MeasurableSpace H]
    [SeminormedAddCommGroup R] [TopologicalSpace R] [MeasurableSpace R]
    [OpensMeasurableSpace R]
    (P : ℕ -> Measure Ω) (LimitLaw : Measure ΩLimit)
    [∀ n, IsProbabilityMeasure (P n)] [IsProbabilityMeasure LimitLaw] where
  /-- Tail approximation of the full risk process by truncated processes. -/
  tailApproximationSource :
    Vaart1998BayesRiskProcessTailApproximationSource (H := H)
      (R := R) P
  /-- Limiting posterior-risk process `Z`. -/
  limitRiskProcess : ΩLimit -> R
  /-- Weak convergence of the selected truncated process. -/
  truncatedRiskProcess_tendstoInDistribution :
    TendstoInDistribution
      tailApproximationSource.truncatedRiskProcess atTop limitRiskProcess
      P LimitLaw
  /--
  Slutsky/diagonal transfer from truncated compact-process convergence and
  tail negligibility to convergence of the full risk process.
  -/
  tailSlutskyTransfer :
    Vaart1998MeasureSeqConvergesInProbabilityToZero P
        (fun n ω =>
          tailApproximationSource.riskProcess n ω -
            tailApproximationSource.truncatedRiskProcess n ω) ->
      TendstoInDistribution
        tailApproximationSource.truncatedRiskProcess atTop
        limitRiskProcess P LimitLaw ->
      TendstoInDistribution
        tailApproximationSource.riskProcess atTop
        limitRiskProcess P LimitLaw

/--
The compact risk-process convergence certificate carried by a Chapter 10
risk-process source.
-/
theorem Vaart1998BayesCompactRiskProcessConvergenceSource.riskProcess_tendstoInDistribution
    {Ω ΩLimit H R : Type*} [MeasurableSpace Ω]
    [MeasurableSpace ΩLimit] [MeasurableSpace H]
    [SeminormedAddCommGroup R] [TopologicalSpace R] [MeasurableSpace R]
    [OpensMeasurableSpace R]
    {P : ℕ -> Measure Ω} {LimitLaw : Measure ΩLimit}
    [∀ n, IsProbabilityMeasure (P n)] [IsProbabilityMeasure LimitLaw]
    (S : Vaart1998BayesCompactRiskProcessConvergenceSource
      (H := H) (R := R) P LimitLaw) :
    TendstoInDistribution S.tailApproximationSource.riskProcess atTop
      S.limitRiskProcess P LimitLaw :=
  S.tailSlutskyTransfer
    S.tailApproximationSource.riskProcess_sub_truncated_convergesInProbability
    S.truncatedRiskProcess_tendstoInDistribution

/--
Chapter 10 diagonal-radius source for the selected truncation level `M_n`.

The proof of Theorem 10.8 first proves compact-process convergence for fixed
truncation radii and then chooses a diverging radius sequence.  This source
records that selected sequence and packages the resulting truncated process.
-/
structure Vaart1998BayesDiagonalRadiusTruncationSource
    {Ω ΩLimit H R : Type*} [MeasurableSpace Ω]
    [MeasurableSpace ΩLimit] [MeasurableSpace H]
    [SeminormedAddCommGroup R] [TopologicalSpace R] [MeasurableSpace R]
    [OpensMeasurableSpace R]
    (P : ℕ -> Measure Ω) (LimitLaw : Measure ΩLimit)
    [∀ n, IsProbabilityMeasure (P n)] [IsProbabilityMeasure LimitLaw] where
  /-- Posterior-tail negligibility source for the chosen complements `C_nᶜ`. -/
  tailSource : Vaart1998BayesPosteriorTailTruncationSource
    (H := H) P
  /-- Diverging truncation radius sequence `M_n`. -/
  radius : ℕ -> ℝ
  /-- The chosen radii diverge. -/
  radius_tendsto_atTop : Tendsto radius atTop atTop
  /-- Eventually the chosen radii are positive. -/
  radius_eventually_pos : ∀ᶠ n in atTop, 0 < radius n
  /-- Full posterior-risk process `Z_n`. -/
  riskProcess : ℕ -> Ω -> R
  /-- Selected truncated posterior-risk process `Z_{n,M_n}`. -/
  selectedTruncatedRiskProcess : ℕ -> Ω -> R
  /-- Limiting posterior-risk process `Z`. -/
  limitRiskProcess : ΩLimit -> R
  /-- Weak convergence of the selected truncated process. -/
  selectedTruncatedRiskProcess_tendstoInDistribution :
    TendstoInDistribution selectedTruncatedRiskProcess atTop
      limitRiskProcess P LimitLaw
  /-- The selected truncation error is bounded by the posterior tail display. -/
  riskProcess_sub_selected_norm_le_tailIntegral :
    ∀ n ω,
      ‖riskProcess n ω - selectedTruncatedRiskProcess n ω‖ ≤
        ‖tailSource.tailIntegralDisplay n ω‖
  /-- Slutsky transfer from selected truncated convergence to full convergence. -/
  tailSlutskyTransfer :
    Vaart1998MeasureSeqConvergesInProbabilityToZero P
        (fun n ω => riskProcess n ω - selectedTruncatedRiskProcess n ω) ->
      TendstoInDistribution selectedTruncatedRiskProcess atTop
        limitRiskProcess P LimitLaw ->
      TendstoInDistribution riskProcess atTop limitRiskProcess P LimitLaw

/--
The selected diagonal truncation gives a tail-approximation source.
-/
def Vaart1998BayesDiagonalRadiusTruncationSource.tailApproximationSource
    {Ω ΩLimit H R : Type*} [MeasurableSpace Ω]
    [MeasurableSpace ΩLimit] [MeasurableSpace H]
    [SeminormedAddCommGroup R] [TopologicalSpace R] [MeasurableSpace R]
    [OpensMeasurableSpace R]
    {P : ℕ -> Measure Ω} {LimitLaw : Measure ΩLimit}
    [∀ n, IsProbabilityMeasure (P n)] [IsProbabilityMeasure LimitLaw]
    (S : Vaart1998BayesDiagonalRadiusTruncationSource
      (H := H) (R := R) P LimitLaw) :
    Vaart1998BayesRiskProcessTailApproximationSource (H := H)
      (R := R) P :=
  { tailSource := S.tailSource
    riskProcess := S.riskProcess
    truncatedRiskProcess := S.selectedTruncatedRiskProcess
    riskProcess_sub_truncated_norm_le_tailIntegral :=
      S.riskProcess_sub_selected_norm_le_tailIntegral }

/--
The selected diagonal truncation error is `o_{P_n}(1)`.
-/
theorem Vaart1998BayesDiagonalRadiusTruncationSource.riskProcess_sub_selected_convergesInProbability
    {Ω ΩLimit H R : Type*} [MeasurableSpace Ω]
    [MeasurableSpace ΩLimit] [MeasurableSpace H]
    [SeminormedAddCommGroup R] [TopologicalSpace R] [MeasurableSpace R]
    [OpensMeasurableSpace R]
    {P : ℕ -> Measure Ω} {LimitLaw : Measure ΩLimit}
    [∀ n, IsProbabilityMeasure (P n)] [IsProbabilityMeasure LimitLaw]
    (S : Vaart1998BayesDiagonalRadiusTruncationSource
      (H := H) (R := R) P LimitLaw) :
    Vaart1998MeasureSeqConvergesInProbabilityToZero P
      (fun n ω => S.riskProcess n ω -
        S.selectedTruncatedRiskProcess n ω) :=
  S.tailApproximationSource.riskProcess_sub_truncated_convergesInProbability

/--
A diagonal-radius source yields the compact risk-process convergence source
used by the argmin theorem.
-/
def Vaart1998BayesDiagonalRadiusTruncationSource.compactRiskProcessConvergenceSource
    {Ω ΩLimit H R : Type*} [MeasurableSpace Ω]
    [MeasurableSpace ΩLimit] [MeasurableSpace H]
    [SeminormedAddCommGroup R] [TopologicalSpace R] [MeasurableSpace R]
    [OpensMeasurableSpace R]
    {P : ℕ -> Measure Ω} {LimitLaw : Measure ΩLimit}
    [∀ n, IsProbabilityMeasure (P n)] [IsProbabilityMeasure LimitLaw]
    (S : Vaart1998BayesDiagonalRadiusTruncationSource
      (H := H) (R := R) P LimitLaw) :
    Vaart1998BayesCompactRiskProcessConvergenceSource (H := H)
      (R := R) P LimitLaw :=
  { tailApproximationSource := S.tailApproximationSource
    limitRiskProcess := S.limitRiskProcess
    truncatedRiskProcess_tendstoInDistribution :=
      S.selectedTruncatedRiskProcess_tendstoInDistribution
    tailSlutskyTransfer := S.tailSlutskyTransfer }

/--
The full posterior-risk process converges after diagonal radius selection.
-/
theorem Vaart1998BayesDiagonalRadiusTruncationSource.riskProcess_tendstoInDistribution
    {Ω ΩLimit H R : Type*} [MeasurableSpace Ω]
    [MeasurableSpace ΩLimit] [MeasurableSpace H]
    [SeminormedAddCommGroup R] [TopologicalSpace R] [MeasurableSpace R]
    [OpensMeasurableSpace R]
    {P : ℕ -> Measure Ω} {LimitLaw : Measure ΩLimit}
    [∀ n, IsProbabilityMeasure (P n)] [IsProbabilityMeasure LimitLaw]
    (S : Vaart1998BayesDiagonalRadiusTruncationSource
      (H := H) (R := R) P LimitLaw) :
    TendstoInDistribution S.riskProcess atTop S.limitRiskProcess
      P LimitLaw :=
  S.compactRiskProcessConvergenceSource.riskProcess_tendstoInDistribution

/--
Chapter 10 Bayes point-estimator limit source.

This is the point-estimator consequence layer of BvM: after a posterior
approximation source and a Bayes posterior-risk minimizer are available, the
standardized estimator is recorded as converging in distribution to the
corresponding limit-experiment Bayes functional.
-/
structure Vaart1998BayesPointEstimatorLimitSource
    {Ω ΩLimit H T : Type*} [MeasurableSpace Ω] [MeasurableSpace ΩLimit]
    [MeasurableSpace H]
    [TopologicalSpace T] [MeasurableSpace T] [OpensMeasurableSpace T]
    (P : ℕ -> Measure Ω) (LimitLaw : Measure ΩLimit)
    [∀ n, IsProbabilityMeasure (P n)] [IsProbabilityMeasure LimitLaw] where
  /-- BvM approximation of the full posterior laws. -/
  bvmSource : Vaart1998BvMPosteriorApproximationSource (H := H) P
  /-- Posterior-risk minimizer that defines the Bayes point estimator. -/
  minimizerSource :
    Vaart1998BayesPosteriorRiskMinimizerSource
      (T := T) bvmSource.posteriorKernel
  /-- Limit-experiment Bayes functional. -/
  limitEstimator : ΩLimit -> T
  /-- Frequentist weak limit of the standardized Bayes point estimator. -/
  estimator_tendstoInDistribution :
    TendstoInDistribution minimizerSource.estimator atTop limitEstimator
      P LimitLaw

/--
The weak limit certificate carried by a Bayes point-estimator source.
-/
theorem Vaart1998BayesPointEstimatorLimitSource.tendstoInDistribution
    {Ω ΩLimit H T : Type*} [MeasurableSpace Ω] [MeasurableSpace ΩLimit]
    [MeasurableSpace H]
    [TopologicalSpace T] [MeasurableSpace T] [OpensMeasurableSpace T]
    {P : ℕ -> Measure Ω} {LimitLaw : Measure ΩLimit}
    [∀ n, IsProbabilityMeasure (P n)] [IsProbabilityMeasure LimitLaw]
    (S : Vaart1998BayesPointEstimatorLimitSource
      (H := H) (T := T) P LimitLaw) :
    TendstoInDistribution S.minimizerSource.estimator atTop
      S.limitEstimator P LimitLaw :=
  S.estimator_tendstoInDistribution

/--
A Chapter 10 Bayes point-estimator limit is a one-parameter Chapter 9
experiment-limit source.
-/
def Vaart1998BayesPointEstimatorLimitSource.experimentLimitSource
    {Ω ΩLimit H T : Type*} [MeasurableSpace Ω] [MeasurableSpace ΩLimit]
    [MeasurableSpace H]
    [TopologicalSpace T] [MeasurableSpace T] [OpensMeasurableSpace T]
    {P : ℕ -> Measure Ω} {LimitLaw : Measure ΩLimit}
    [∀ n, IsProbabilityMeasure (P n)] [IsProbabilityMeasure LimitLaw]
    (S : Vaart1998BayesPointEstimatorLimitSource
      (H := H) (T := T) P LimitLaw) :
    Vaart1998ExperimentLimitSource
      (Ω := Ω) (ΩLimit := ΩLimit) (Θ := Unit) (Z := T)
      (fun _ : Unit => P) (fun _ : Unit => LimitLaw) :=
  { parameterSet := Set.univ
    statistic := S.minimizerSource.estimator
    limitStatistic := S.limitEstimator
    statistic_tendstoInDistribution := fun _ _ =>
      S.estimator_tendstoInDistribution }

/--
The Bayes point estimator remains a posterior-risk minimizer inside the
combined BvM/point-estimator source.
-/
theorem Vaart1998BayesPointEstimatorLimitSource.minimizes_posteriorRisk
    {Ω ΩLimit H T : Type*} [MeasurableSpace Ω] [MeasurableSpace ΩLimit]
    [MeasurableSpace H]
    [TopologicalSpace T] [MeasurableSpace T] [OpensMeasurableSpace T]
    {P : ℕ -> Measure Ω} {LimitLaw : Measure ΩLimit}
    [∀ n, IsProbabilityMeasure (P n)] [IsProbabilityMeasure LimitLaw]
    (S : Vaart1998BayesPointEstimatorLimitSource
      (H := H) (T := T) P LimitLaw)
    (n : ℕ) (ω : Ω) (t : T) :
    vaart1998_bayesPosteriorRiskAt S.bvmSource.posteriorKernel
      S.minimizerSource.loss (S.minimizerSource.estimator n ω) n ω ≤
    vaart1998_bayesPosteriorRiskAt S.bvmSource.posteriorKernel
      S.minimizerSource.loss t n ω :=
  S.minimizerSource.minimizes_posteriorRisk n ω t

/--
Chapter 10 argmin continuous-mapping source for Bayes estimators.

This packages the proof skeleton of Theorem 10.8: posterior risk processes
converge weakly in a process space, a continuous argmin functional selects
the estimator, and therefore the Bayes estimator converges to the argmin of
the limiting posterior risk process.
-/
structure Vaart1998BayesArgminContinuitySource
    {Ω ΩLimit H R T : Type*} [MeasurableSpace Ω] [MeasurableSpace ΩLimit]
    [MeasurableSpace H]
    [TopologicalSpace R] [MeasurableSpace R] [OpensMeasurableSpace R]
    [TopologicalSpace T] [MeasurableSpace T] [BorelSpace T]
    [OpensMeasurableSpace T]
    (P : ℕ -> Measure Ω) (LimitLaw : Measure ΩLimit)
    [∀ n, IsProbabilityMeasure (P n)] [IsProbabilityMeasure LimitLaw] where
  /-- Functional BvM approximation supplying the posterior-law side. -/
  functionalSource :
    Vaart1998BvMPosteriorFunctionalApproximationSource (H := H)
      (T := T) P
  /-- Posterior-risk process, such as `t ↦ Z_n(t)` on a compact set. -/
  riskProcess : ℕ -> Ω -> R
  /-- Limiting posterior-risk process, such as `t ↦ Z(t)`. -/
  limitRiskProcess : ΩLimit -> R
  /-- Continuous argmin/selection map from risk processes to decisions. -/
  argminFunctional : R -> T
  /-- Continuity assumption supplied by the argmax/argmin theorem. -/
  argminFunctional_continuous : Continuous argminFunctional
  /-- Weak convergence of posterior-risk processes. -/
  riskProcess_tendstoInDistribution :
    TendstoInDistribution riskProcess atTop limitRiskProcess P LimitLaw
  /-- Posterior-risk minimizer that represents the Bayes estimator. -/
  minimizerSource :
    Vaart1998BayesPosteriorRiskMinimizerSource
      (T := T) functionalSource.bvmSource.posteriorKernel
  /-- The Bayes estimator is the argmin of the finite-sample risk process. -/
  estimator_eq_argminFunctional :
    ∀ n ω,
      minimizerSource.estimator n ω =
        argminFunctional (riskProcess n ω)
  /-- Limiting Bayes estimator. -/
  limitEstimator : ΩLimit -> T
  /-- The limiting estimator is the argmin of the limiting risk process. -/
  limitEstimator_eq_argminFunctional :
    ∀ ω,
      limitEstimator ω = argminFunctional (limitRiskProcess ω)

/--
The argmin continuous-mapping certificate for Chapter 10 Bayes estimators.
-/
theorem Vaart1998BayesArgminContinuitySource.tendstoInDistribution
    {Ω ΩLimit H R T : Type*} [MeasurableSpace Ω] [MeasurableSpace ΩLimit]
    [MeasurableSpace H]
    [TopologicalSpace R] [MeasurableSpace R] [OpensMeasurableSpace R]
    [TopologicalSpace T] [MeasurableSpace T] [BorelSpace T]
    [OpensMeasurableSpace T]
    {P : ℕ -> Measure Ω} {LimitLaw : Measure ΩLimit}
    [∀ n, IsProbabilityMeasure (P n)] [IsProbabilityMeasure LimitLaw]
    (S : Vaart1998BayesArgminContinuitySource
      (H := H) (R := R) (T := T) P LimitLaw) :
    TendstoInDistribution S.minimizerSource.estimator atTop
      S.limitEstimator P LimitLaw := by
  have hArgmin :
      TendstoInDistribution
        (fun n ω => S.argminFunctional (S.riskProcess n ω)) atTop
        (fun ω => S.argminFunctional (S.limitRiskProcess ω))
        P LimitLaw :=
    TendstoInDistribution.continuous_comp S.argminFunctional_continuous
      S.riskProcess_tendstoInDistribution
  refine hArgmin.congr ?_ ?_
  · intro n
    exact ae_of_all _ fun ω => by
      simp [S.estimator_eq_argminFunctional n ω]
  · exact ae_of_all _ fun ω => by
      simp [S.limitEstimator_eq_argminFunctional ω]

/--
A Chapter 10 argmin-continuity source is a Bayes point-estimator limit source.
-/
def Vaart1998BayesArgminContinuitySource.bayesPointEstimatorLimitSource
    {Ω ΩLimit H R T : Type*} [MeasurableSpace Ω] [MeasurableSpace ΩLimit]
    [MeasurableSpace H]
    [TopologicalSpace R] [MeasurableSpace R] [OpensMeasurableSpace R]
    [TopologicalSpace T] [MeasurableSpace T] [BorelSpace T]
    [OpensMeasurableSpace T]
    {P : ℕ -> Measure Ω} {LimitLaw : Measure ΩLimit}
    [∀ n, IsProbabilityMeasure (P n)] [IsProbabilityMeasure LimitLaw]
    (S : Vaart1998BayesArgminContinuitySource
      (H := H) (R := R) (T := T) P LimitLaw) :
    Vaart1998BayesPointEstimatorLimitSource (H := H) (T := T)
      P LimitLaw :=
  { bvmSource := S.functionalSource.bvmSource
    minimizerSource := S.minimizerSource
    limitEstimator := S.limitEstimator
    estimator_tendstoInDistribution := S.tendstoInDistribution }

/--
A compact risk-process convergence source supplies the risk-process field of
the Chapter 10 argmin-continuity source.
-/
def Vaart1998BayesCompactRiskProcessConvergenceSource.argminContinuitySource
    {Ω ΩLimit H R T : Type*} [MeasurableSpace Ω]
    [MeasurableSpace ΩLimit] [MeasurableSpace H]
    [SeminormedAddCommGroup R] [TopologicalSpace R] [MeasurableSpace R]
    [OpensMeasurableSpace R]
    [TopologicalSpace T] [MeasurableSpace T] [BorelSpace T]
    [OpensMeasurableSpace T]
    {P : ℕ -> Measure Ω} {LimitLaw : Measure ΩLimit}
    [∀ n, IsProbabilityMeasure (P n)] [IsProbabilityMeasure LimitLaw]
    (S : Vaart1998BayesCompactRiskProcessConvergenceSource
      (H := H) (R := R) P LimitLaw)
    (functionalSource :
      Vaart1998BvMPosteriorFunctionalApproximationSource (H := H)
        (T := T) P)
    (argminFunctional : R -> T)
    (argminFunctional_continuous : Continuous argminFunctional)
    (minimizerSource :
      Vaart1998BayesPosteriorRiskMinimizerSource
        (T := T) functionalSource.bvmSource.posteriorKernel)
    (estimator_eq_argminFunctional :
      ∀ n ω,
        minimizerSource.estimator n ω =
          argminFunctional (S.tailApproximationSource.riskProcess n ω))
    (limitEstimator : ΩLimit -> T)
    (limitEstimator_eq_argminFunctional :
      ∀ ω, limitEstimator ω = argminFunctional (S.limitRiskProcess ω)) :
    Vaart1998BayesArgminContinuitySource
      (H := H) (R := R) (T := T) P LimitLaw :=
  { functionalSource := functionalSource
    riskProcess := S.tailApproximationSource.riskProcess
    limitRiskProcess := S.limitRiskProcess
    argminFunctional := argminFunctional
    argminFunctional_continuous := argminFunctional_continuous
    riskProcess_tendstoInDistribution := S.riskProcess_tendstoInDistribution
    minimizerSource := minimizerSource
    estimator_eq_argminFunctional := estimator_eq_argminFunctional
    limitEstimator := limitEstimator
    limitEstimator_eq_argminFunctional := limitEstimator_eq_argminFunctional }

/--
The compact-risk-process route directly yields a Bayes point-estimator limit
once the argmin selector and posterior-risk minimizer are supplied.
-/
def Vaart1998BayesCompactRiskProcessConvergenceSource.bayesPointEstimatorLimitSource
    {Ω ΩLimit H R T : Type*} [MeasurableSpace Ω]
    [MeasurableSpace ΩLimit] [MeasurableSpace H]
    [SeminormedAddCommGroup R] [TopologicalSpace R] [MeasurableSpace R]
    [OpensMeasurableSpace R]
    [TopologicalSpace T] [MeasurableSpace T] [BorelSpace T]
    [OpensMeasurableSpace T]
    {P : ℕ -> Measure Ω} {LimitLaw : Measure ΩLimit}
    [∀ n, IsProbabilityMeasure (P n)] [IsProbabilityMeasure LimitLaw]
    (S : Vaart1998BayesCompactRiskProcessConvergenceSource
      (H := H) (R := R) P LimitLaw)
    (functionalSource :
      Vaart1998BvMPosteriorFunctionalApproximationSource (H := H)
        (T := T) P)
    (argminFunctional : R -> T)
    (argminFunctional_continuous : Continuous argminFunctional)
    (minimizerSource :
      Vaart1998BayesPosteriorRiskMinimizerSource
        (T := T) functionalSource.bvmSource.posteriorKernel)
    (estimator_eq_argminFunctional :
      ∀ n ω,
        minimizerSource.estimator n ω =
          argminFunctional (S.tailApproximationSource.riskProcess n ω))
    (limitEstimator : ΩLimit -> T)
    (limitEstimator_eq_argminFunctional :
      ∀ ω, limitEstimator ω = argminFunctional (S.limitRiskProcess ω)) :
    Vaart1998BayesPointEstimatorLimitSource (H := H) (T := T)
      P LimitLaw :=
  (S.argminContinuitySource functionalSource argminFunctional
    argminFunctional_continuous minimizerSource
    estimator_eq_argminFunctional limitEstimator
    limitEstimator_eq_argminFunctional).bayesPointEstimatorLimitSource

/--
Chapter 10 nonzero-subconvex-loss center source.

The final sentence of Theorem 10.8 uses Anderson's lemma to identify the
limit argmin, for a nonzero subconvex loss, with the center `X` of the
Gaussian posterior.  This source records that Anderson-lemma identification
and transfers the already-proved Bayes estimator limit to the Gaussian center.
-/
structure Vaart1998BayesNonzeroSubconvexLossCenterSource
    {Ω ΩLimit H T : Type*} [MeasurableSpace Ω]
    [MeasurableSpace ΩLimit] [MeasurableSpace H]
    [TopologicalSpace T] [MeasurableSpace T] [OpensMeasurableSpace T]
    (P : ℕ -> Measure Ω) (LimitLaw : Measure ΩLimit)
    [∀ n, IsProbabilityMeasure (P n)] [IsProbabilityMeasure LimitLaw] where
  /-- Bayes point-estimator limit source from the argmin route. -/
  bayesPointSource :
    Vaart1998BayesPointEstimatorLimitSource (H := H) (T := T)
      P LimitLaw
  /-- Center of the limiting Gaussian posterior, denoted `X` in the theorem. -/
  gaussianCenter : ΩLimit -> T
  /-- Anderson/subconvex-loss certificate: the limit argmin is the center. -/
  andersonSubconvex_limitEstimator_eq_center :
    ∀ ω, bayesPointSource.limitEstimator ω = gaussianCenter ω

/--
For a nonzero subconvex loss, the standardized Bayes estimator converges to
the center `X` of the limiting Gaussian posterior.
-/
theorem Vaart1998BayesNonzeroSubconvexLossCenterSource.tendstoInDistribution_gaussianCenter
    {Ω ΩLimit H T : Type*} [MeasurableSpace Ω]
    [MeasurableSpace ΩLimit] [MeasurableSpace H]
    [TopologicalSpace T] [MeasurableSpace T] [OpensMeasurableSpace T]
    {P : ℕ -> Measure Ω} {LimitLaw : Measure ΩLimit}
    [∀ n, IsProbabilityMeasure (P n)] [IsProbabilityMeasure LimitLaw]
    (S : Vaart1998BayesNonzeroSubconvexLossCenterSource
      (H := H) (T := T) P LimitLaw) :
    TendstoInDistribution S.bayesPointSource.minimizerSource.estimator atTop
      S.gaussianCenter P LimitLaw := by
  refine S.bayesPointSource.tendstoInDistribution.congr
    (fun _ => Filter.EventuallyEq.rfl) ?_
  exact ae_of_all _ fun ω =>
    S.andersonSubconvex_limitEstimator_eq_center ω

/--
The nonzero-subconvex-loss center limit as a one-parameter Chapter 9
experiment-limit source.
-/
def Vaart1998BayesNonzeroSubconvexLossCenterSource.experimentLimitSource
    {Ω ΩLimit H T : Type*} [MeasurableSpace Ω]
    [MeasurableSpace ΩLimit] [MeasurableSpace H]
    [TopologicalSpace T] [MeasurableSpace T] [OpensMeasurableSpace T]
    {P : ℕ -> Measure Ω} {LimitLaw : Measure ΩLimit}
    [∀ n, IsProbabilityMeasure (P n)] [IsProbabilityMeasure LimitLaw]
    (S : Vaart1998BayesNonzeroSubconvexLossCenterSource
      (H := H) (T := T) P LimitLaw) :
    Vaart1998ExperimentLimitSource
      (Ω := Ω) (ΩLimit := ΩLimit) (Θ := Unit) (Z := T)
      (fun _ : Unit => P) (fun _ : Unit => LimitLaw) :=
  { parameterSet := Set.univ
    statistic := S.bayesPointSource.minimizerSource.estimator
    limitStatistic := S.gaussianCenter
    statistic_tendstoInDistribution := fun _ _ =>
      S.tendstoInDistribution_gaussianCenter }

