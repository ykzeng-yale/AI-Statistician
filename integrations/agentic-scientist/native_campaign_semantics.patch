+            raise ValueError("missing native review identity")
+        with (program_dir / "scientific_review_stdout.log").open("xb") as stdout, (
+            program_dir / "scientific_review_stderr.log"
+        ).open("xb") as stderr:
+            result = subprocess.run(
+                [python, entrypoint, "--stage", "review", "--program-dir", str(program_dir),
+                 "--task-dir", str(experiment_dir), "--rubrics-file", str(rubrics_path.resolve()),
+                 "--model", model],
+                cwd=str(experiment_dir), env=dict(environment), stdin=subprocess.DEVNULL,
+                stdout=stdout, stderr=stderr, timeout=timeout_seconds, check=False,
+            )
+        if result.returncode != 0:
+            raise ValueError(f"scientific reviewer exited {result.returncode}")
+        summary = _read_harness_json(program_dir / "scientific_review.json") or {}
+        if not (
+            type(summary.get("schema_version")) is int and summary["schema_version"] == 1
+            and summary.get("kind") == "ai_scientific_review"
+            and isinstance(summary.get("scope"), str) and summary["scope"].strip()
+            and summary.get("model") == model
+            and summary.get("task_sha256") == task_sha256 == _file_digest(experiment_dir / "task.md")
+            and summary.get("rubrics_sha256") == rubrics_sha256 == _json_digest(_target_rubrics(rubrics_path))
+            and summary.get("source_records") == source_records
+            and source_records == native_source_identity(program_dir, expected=source_records)
+        ):
+            raise ValueError("missing, malformed or stale scientific review identity")
+        for key, name in (("report", "scientific_review.md"),
+                          ("session", ".scientific-review/session/result.json")):
+            if summary.get(key) != {"path": name, "sha256": _file_digest(program_dir / name)}:
+                raise ValueError(f"stale scientific review {key}")
+        review_ids = {item["id"] for item in target_rubrics if item.get("type") == "review"}
+        verdicts = summary.get("verdicts")
+        if not isinstance(verdicts, list) or len(verdicts) != len(review_ids) or any(
