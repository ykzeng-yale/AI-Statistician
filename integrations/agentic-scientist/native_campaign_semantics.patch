+def load_fixed_target_rubrics(task_dir: Path) -> list[dict[str, Any]] | None:
+    """Read operator-owned requirements; absence alone selects optimization mode."""
+    path = task_dir / "target_rubrics.json"
+    if not path.exists() and not path.is_symlink():
+        return None
+    if path.is_symlink() or not path.is_file():
+        raise ValueError("fixed target rubrics must be a regular file")
+    try:
+        raw = json.loads(path.read_text(encoding="utf-8"))
+        normalized = normalize_target_rubrics_payload(raw)
+    except (OSError, ValueError, IdeaBundleValidationError) as exc:
+        raise ValueError(f"invalid fixed target rubrics: {exc}") from exc
+    if not isinstance(raw, list) or len(raw) > MAX_HARNESS_RUBRICS:
+        raise ValueError("fixed target rubrics must be a nonempty bounded rubric list")
+    # Normalization intentionally drops metric fields for generated ideas. Operator
+    # requirements retain them, and must already have explicit, unique normalized IDs.
+    for item, canonical in zip(raw, normalized):
+        if item.get("id") != canonical["id"] or item.get("type") != canonical["type"]:
+            raise ValueError("fixed rubrics require explicit unique IDs and types")
+        if item["type"] == "metric" and rubric_metric_check(item) is None:
+            raise ValueError("fixed metric rubric requires a numeric threshold")
+    return raw
