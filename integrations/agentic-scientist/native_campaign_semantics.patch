+from .program_spec import entrypoint_relpath_from_spec, load_program_spec
 
 _MAX_ARTIFACT_BYTES = 1024 * 1024
+
+
+def _json_digest(value: object) -> str:
+    return hashlib.sha256(json.dumps(value, sort_keys=True, allow_nan=False).encode()).hexdigest()
+
+
+def _file_digest(path: Path) -> str:
+    if path.is_symlink() or not path.is_file():
+        raise ValueError(f"evidence must be a regular file: {path}")
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        while chunk := stream.read(1024 * 1024):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def native_source_identity(
+    program_dir: Path, *, expected: dict[str, str] | None = None,
+) -> dict[str, str]:
+    if program_dir.is_symlink() or not program_dir.is_dir():
+        raise ValueError("native candidate must be a real directory")
+    records = _program_source_records(program_dir)
+    if not records:
+        raise ValueError("native candidate source is empty or indirect")
+    spec = load_program_spec(program_dir)
+    assert spec is not None
+    if expected is not None:
+        # v1 puts source under src and results at program root. Preserve every
+        # pre-evaluation input, but do not misclassify new result files as source.
+        records = {name: digest for name, digest in records.items()
+                   if name in expected or name == "program_spec.toml"
+                   or name.startswith(spec.code_root + "/")}
+    return records
+
+
+def native_evidence_identity(
+    program_dir: Path, *, source_records: dict[str, str] | None = None,
+) -> dict[str, str]:
+    names = {
+        "metrics.json", "correct.json", "rubric_status.json",
+        "harness_evaluate_stdout.log", "harness_evaluate_stderr.log",
+        "evaluation_evidence.json", "stdout.log", "stderr.log",
+    }
+    if source_records is not None:
+        names.update(
+            path.relative_to(program_dir).as_posix() for path in program_dir.rglob("*")
+            if (path.is_file() or path.is_symlink())
+            and "__pycache__" not in path.relative_to(program_dir).parts
+        )
+        names.difference_update(source_records)
+        names.discard("evaluation_manifest.json")
+    return {
+        name: _file_digest(program_dir / name)
+        for name in names
+        if (program_dir / name).exists() or (program_dir / name).is_symlink()
+    }
+
+
+@dataclass(frozen=True)
+class NativeEvaluation:
+    score: float | None
+    correct: bool | None
+    status: dict[str, Any]
+    manifest_sha256: str
+    complete: bool
+
+
+def read_native_evaluation(
+    program_dir: Path,
+    target_rubrics: list[dict[str, Any]],
+    *,
+    attempt_id: str,
+    idea_id: str,
+) -> NativeEvaluation:
+    """Read a completed native receipt, never infer acceptance from loose JSON."""
+    from src.orchestrator.rubrics import validate_rubric_status
+
+    manifest_path = program_dir / "evaluation_manifest.json"
+    manifest = _read_harness_json(manifest_path)
+    entrypoint = entrypoint_relpath_from_spec(program_dir)
+    command = manifest.get("command") if manifest else None
+    if not manifest or not (
+        manifest.get("producer") == "harness_eval"
+        and manifest.get("native_receipt_version") == 1
+        and manifest.get("execution_boundary") == "native"
+        and manifest.get("program_dir") == str(program_dir.resolve())
+        and manifest.get("program_id") == program_dir.name == "program_1"
+        and manifest.get("attempt_id") == attempt_id
+        and manifest.get("idea_id") == idea_id
+        and manifest.get("completed") is True
+        and type(manifest.get("exit_code")) is int
+        and isinstance(manifest.get("started_at"), str)
+        and isinstance(manifest.get("finished_at"), str)
+        and isinstance(command, list) and len(command) == 6
+        and command[1:] == [str(program_dir.parent / "evaluate.py"), "--program_path",
+                              str(program_dir / entrypoint), "--results_dir", str(program_dir)]
+        and isinstance(manifest.get("source_records"), dict)
+        and manifest["source_records"] == native_source_identity(program_dir, expected=manifest["source_records"])
+        and manifest.get("evaluator_sha256") == _file_digest(program_dir.parent / "evaluate.py")
+        and manifest.get("rubrics_sha256") == _json_digest(target_rubrics)
+        and manifest.get("evidence_records") == native_evidence_identity(program_dir, source_records=manifest["source_records"])
+    ):
+        raise ValueError(f"missing, malformed or stale native evaluation: {program_dir}")
+    status = _read_harness_json(program_dir / "rubric_status.json")
+    if status != _read_harness_json(program_dir.parent / "rubric_status.json"):
+        raise ValueError("native root and candidate rubric status disagree")
+    validation = validate_rubric_status(
+        status, {item["id"] for item in target_rubrics},
+        expected_attempt_id=attempt_id, expected_idea_id=idea_id,
+    )
+    if not validation.valid or status is None:
+        raise ValueError(f"invalid native rubric status: {validation.error}")
+    metrics = _read_harness_json(program_dir / "metrics.json")
+    correctness = _read_harness_json(program_dir / "correct.json")
+    score = _finite_score(metrics.get("combined_score")) if metrics else None
+    correct = correctness.get("correct") if correctness else None
+    if manifest["exit_code"] == 0 and (score is None or not isinstance(correct, bool)):
+        raise ValueError("completed native evaluation requires finite score and boolean correctness")
+    if validation.overall_pass and (manifest["exit_code"] != 0 or correct is not True):
+        raise ValueError("native acceptance requires evaluator correctness")
+    return NativeEvaluation(
+        score, correct if isinstance(correct, bool) else None, status,
+        _file_digest(manifest_path),
+        manifest["exit_code"] == 0 and correct is True and validation.overall_pass,
+    )
+
+
+def fixed_campaign_identity(
+    task_dir: Path, seed_program_dir: Path, target_rubrics: list[dict[str, Any]],
+) -> dict[str, Any]:
+    return {
+        "task_dir": str(task_dir.resolve()),
+        "task_sha256": evaluator_tree_digest(task_dir),
+        "seed_dir": str(seed_program_dir.resolve()),
+        "seed_sources": native_source_identity(seed_program_dir),
+        "rubrics_sha256": _json_digest(target_rubrics),
+    }
+
+
+def validate_fixed_campaign_resume(
+    *, task_dir: Path, results_dir: Path, seed_program_dir: Path,
+    target_rubrics: list[dict[str, Any]] | None, resume: bool,
+) -> dict[str, Any] | None:
+    """Validate existing state before the permissive upstream initializers can reset it."""
+    from src.orchestrator import state as state_store
+
+    state_path = results_dir / state_store.OUTER_STATE_FILE
+    best_path = results_dir / state_store.BEST_MANIFEST_FILE
+    old_state = _read_harness_json(state_path)
+    if target_rubrics is None:
+        if old_state and "fixed_requirements" in old_state:
+            raise ValueError("fixed campaign requirements were removed")
+        return None
+    identity = fixed_campaign_identity(task_dir, seed_program_dir, target_rubrics)
+    paths = [state_path, best_path]
+    existing = any(path.exists() or path.is_symlink() for path in paths)
+    if not existing:
+        if results_dir.exists() and any(path.name != "events.jsonl" for path in results_dir.iterdir()):
+            raise ValueError("fixed campaign requires an empty fresh results directory")
+        if native_evidence_identity(seed_program_dir) or (seed_program_dir / "evaluation_manifest.json").exists():
+            raise ValueError("fixed cold start requires an unevaluated seed, not loose evidence")
+        return identity
+    best = _read_harness_json(best_path)
+    if not resume or old_state is None or best is None:
+        raise ValueError("fixed campaign state exists: valid state and explicit resume are required")
+    if old_state.get("fixed_requirements") != identity:
+        raise ValueError("fixed campaign task, source or criteria identity changed")
+    if type(old_state.get("current_cycle")) is not int or old_state["current_cycle"] < 0:
+        raise ValueError("invalid fixed campaign cycle state")
+    history_path = state_store.attempts_history_path(results_dir)
+    if history_path.is_symlink() or not history_path.is_file():
+        raise ValueError("fixed campaign attempt history is missing or indirect")
+    try:
+        history = [json.loads(line) for line in history_path.read_text().splitlines()]
+    except (OSError, ValueError) as exc:
+        raise ValueError("invalid fixed campaign attempt history") from exc
+    consumed: set[Path] = set()
+    accepted: dict[Path, NativeEvaluation] = {}
+    previous_cycle = 0
+    for row in history:
+        if not isinstance(row, dict) or not all(
+            isinstance(row.get(key), str) and row[key]
+            for key in ("experiment_dir", "attempt_id", "idea_id")
+        ):
+            raise ValueError("invalid fixed campaign attempt record")
+        cycle = row.get("cycle_index")
+        if type(cycle) is not int or not previous_cycle < cycle <= old_state["current_cycle"]:
+            raise ValueError("fixed attempt history and cycle state disagree")
+        previous_cycle = cycle
+        program = Path(row["experiment_dir"]) / "program_1"
+        if not program.resolve().is_relative_to(results_dir.resolve()) or program in consumed:
+            raise ValueError("fixed candidate is outside campaign or consumed twice")
+        consumed.add(program)
+        evaluation = read_native_evaluation(
+            program, target_rubrics, attempt_id=row["attempt_id"], idea_id=row["idea_id"],
+        )
+        if evaluation.manifest_sha256 != row.get("native_evaluation_manifest_sha256"):
+            raise ValueError("consumed native evaluation changed")
+        if _file_digest(program.parent / "evaluate.py") != _file_digest(task_dir / "evaluate.py"):
+            raise ValueError("consumed native evaluator differs from frozen task")
+        passed = evaluation.complete and row.get("run_exit_code") == 0
+        if row.get("attempt_status") != ("pass" if passed else "fail"):
+            raise ValueError("fixed attempt status disagrees with native evidence")
+        if passed:
+            accepted[program.resolve()] = evaluation
+    observed = {
+        path.parent for path in (results_dir / "ideas").rglob("evaluation_manifest.json")
+        if path.parent.name == "program_1"
+    }
+    if observed != consumed:
+        raise ValueError("fixed campaign contains unrecorded or missing consumed evidence")
+    best_program = _legacy_program_dir(best)
+    if best_program is None or not best_program.is_relative_to(results_dir.resolve()):
+        raise ValueError("fixed incumbent is not campaign-owned")
+    if best.get("source_attempt_id") == "bootstrap":
+        if (best.get("combined_score") is not None or best.get("correct") is not None
+            or native_source_identity(best_program) != identity["seed_sources"]
+            or native_evidence_identity(best_program) or accepted):
+            raise ValueError("invalid fixed bootstrap state")
+    else:
+        evaluation = accepted.get(best_program)
+        if evaluation is None or (
+            best.get("combined_score") != evaluation.score or best.get("correct") is not True
+            or best.get("source_attempt_id") != evaluation.status["attempt_id"]
+        ):
+            raise ValueError("fixed incumbent lacks current accepted native evidence")
+    if (old_state.get("best_program_dir") != str(best_program)
+        or old_state.get("best_combined_score") != best.get("combined_score")
+        or old_state.get("best_correct") != best.get("correct")
+        or old_state.get("task_complete", False) != bool(accepted)):
+        raise ValueError("fixed campaign state and incumbent disagree")
+    return identity
 
 
