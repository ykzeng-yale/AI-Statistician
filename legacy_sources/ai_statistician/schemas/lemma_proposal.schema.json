{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LemmaProposal",
  "type": "object",
  "required": [
    "proposal_id",
    "source_kind",
    "proposed_by",
    "candidate",
    "source_task_ids",
    "domain_tags",
    "expected_premises",
    "required_gates",
    "blocked_reasons",
    "status",
    "action_class",
    "primitive",
    "priority_score",
    "bridge_readiness",
    "candidate_declarations",
    "bridge_candidate_obligations",
    "source_gap_ids",
    "promotion_blocked",
    "candidate_proof_is_empty",
    "candidate_statement_has_placeholder_assumption",
    "proof_evidence_boundary",
    "ok",
    "notes"
  ],
  "properties": {
    "proposal_id": {"type": "string"},
    "source_kind": {"type": "string"},
    "proposed_by": {"type": "string"},
    "candidate": {
      "type": "object",
      "required": [
        "name",
        "statement",
        "proof",
        "motivation_tasks",
        "imports_added",
        "reuse_count",
        "generality_score",
        "semantic_notes"
      ],
      "properties": {
        "name": {"type": "string"},
        "statement": {"type": "string"},
        "proof": {"type": "string"},
        "motivation_tasks": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "imports_added": {"type": "array", "items": {"type": "string"}},
        "reuse_count": {"type": "integer", "minimum": 0},
        "generality_score": {"type": "number"},
        "semantic_notes": {"type": "string"},
        "composition_plan": {
          "type": "object",
          "properties": {
            "target_declaration": {"type": "string"},
            "strategy": {"type": "string"},
            "ordered_obligations": {"type": "array"},
            "ordered_obligation_ids": {"type": "array", "items": {"type": "string"}},
            "remaining_interface": {"type": "array", "items": {"type": "string"}},
            "proof_evidence_boundary": {"type": "string"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "source_task_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "domain_tags": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "expected_premises": {"type": "array", "items": {"type": "string"}},
    "required_gates": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "lean_compiles",
          "no_forbidden_tokens",
          "no_duplicate_statement",
          "minimal_imports",
          "non_vacuity_example",
          "downstream_reuse",
          "statistical_semantic_review"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "blocked_reasons": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string"},
    "action_class": {
      "type": "string",
      "enum": [
        "compose_existing_bridge_chain",
        "add_minimal_wrapper",
        "design_bridge_lemma",
        "design_from_first_principles"
      ]
    },
    "primitive": {"type": "string"},
    "priority_score": {"type": "integer"},
    "bridge_readiness": {"type": "string"},
    "candidate_declarations": {"type": "array", "items": {"type": "string"}},
    "bridge_candidate_obligations": {"type": "array", "items": {"type": "string"}},
    "source_gap_ids": {"type": "array", "items": {"type": "string"}},
    "promotion_blocked": {"type": "boolean"},
    "candidate_proof_is_empty": {"type": "boolean"},
    "candidate_statement_has_placeholder_assumption": {"type": "boolean"},
    "proof_evidence_boundary": {"type": "string"},
    "ok": {"type": "boolean"},
    "errors": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
