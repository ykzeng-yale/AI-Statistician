import StatInference.Optimization.ASGDStepContraction

/-!
# Chewi Chapter 12 general ASGD bridge

This module starts the Chewi Theorem 12.8 route.  It isolates the deterministic
bookkeeping that reduces the general ASGD recursion to the already formalized
quadratic ASGD endpoint plus the Taylor/Hessian residual `zeta`.
-/

namespace StatInference
namespace Optimization

open Filter MeasureTheory ProbabilityTheory
open StatInference.AsymptoticStatistics
open Finset
open scoped BigOperators Topology

/--
The source residual `zeta_n` enters the ASGD recursion in the same position as
the noise increment `xi_{n+1}`.  This shifted sequence has value `zeta_n` at
index `n+1` and a harmless zero at index `0`.
-/
def chewi128ShiftedResidual
    {Ω E : Type*} [Zero E] (zeta : ℕ -> Ω -> E) (n : ℕ) (ω : Ω) : E :=
  match n with
  | 0 => 0
  | k + 1 => zeta k ω

@[simp]
theorem chewi128ShiftedResidual_zero
    {Ω E : Type*} [Zero E] (zeta : ℕ -> Ω -> E) (ω : Ω) :
    chewi128ShiftedResidual zeta 0 ω = 0 := rfl

@[simp]
theorem chewi128ShiftedResidual_succ
    {Ω E : Type*} [Zero E] (zeta : ℕ -> Ω -> E) (n : ℕ) (ω : Ω) :
    chewi128ShiftedResidual zeta (n + 1) ω = zeta n ω := rfl

/--
The perturbed noise sequence `xi_n + zeta_{n-1}` used to view the general ASGD
recursion as a quadratic ASGD recursion.
-/
def chewi128PerturbedNoise
    {Ω E : Type*} [Zero E] [Add E]
    (xi zeta : ℕ -> Ω -> E) (n : ℕ) (ω : Ω) : E :=
  xi n ω + chewi128ShiftedResidual zeta n ω

@[simp]
theorem chewi128PerturbedNoise_succ
    {Ω E : Type*} [Zero E] [Add E]
    (xi zeta : ℕ -> Ω -> E) (n : ℕ) (ω : Ω) :
    chewi128PerturbedNoise xi zeta (n + 1) ω = xi (n + 1) ω + zeta n ω :=
  rfl

/-- The scaled martingale sum is additive in its increment sequence. -/
theorem chewi127ScaledNoiseSum_add
    {Ω E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (xi eta : ℕ -> Ω -> E) (N : ℕ) (ω : Ω) :
    chewi127ScaledNoiseSum (fun n ω => xi n ω + eta n ω) N ω =
      chewi127ScaledNoiseSum xi N ω + chewi127ScaledNoiseSum eta N ω := by
  simp [chewi127ScaledNoiseSum, Finset.sum_add_distrib, smul_add]

/-- The endpoint-corrected ASGD remainder is additive in its increment sequence. -/
theorem chewi123ASGDEndpointCorrectedRemainder_add
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (A Ainv : E →L[ℝ] E) (h : ℕ -> ℝ) (xi eta : ℕ -> E) (N : ℕ) :
    chewi123ASGDEndpointCorrectedRemainder A Ainv h
        (fun n => xi n + eta n) N =
      chewi123ASGDEndpointCorrectedRemainder A Ainv h xi N +
        chewi123ASGDEndpointCorrectedRemainder A Ainv h eta N := by
  simp [chewi123ASGDEndpointCorrectedRemainder, map_add,
    Finset.sum_add_distrib, smul_add]
  module

/--
The extra Chewi 12.8 contribution generated by the Taylor/Hessian residual
`zeta`.  The next analytic packet discharges that this term is `o_P(1)` from
the source estimate `E ||zeta_k|| = O(k^{-gamma})`.
-/
noncomputable def chewi128ASGDZetaContribution
    {Ω E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (A Ainv : E →L[ℝ] E) (h : ℕ -> ℝ)
    (zeta : ℕ -> Ω -> E) (N : ℕ) (ω : Ω) : E :=
  -Ainv (chewi127ScaledNoiseSum (chewi128ShiftedResidual zeta) N ω) +
    chewi123ASGDEndpointCorrectedRemainder A Ainv h
      (fun n => chewi128ShiftedResidual zeta n ω) N

/-- Deterministic envelope corresponding to `chewi128ShiftedResidual`. -/
def chewi128ShiftedResidualBound (b : ℕ -> ℝ) (n : ℕ) : ℝ :=
  match n with
  | 0 => 0
  | k + 1 => b k

@[simp]
theorem chewi128ShiftedResidualBound_zero (b : ℕ -> ℝ) :
    chewi128ShiftedResidualBound b 0 = 0 := rfl

@[simp]
theorem chewi128ShiftedResidualBound_succ (b : ℕ -> ℝ) (n : ℕ) :
    chewi128ShiftedResidualBound b (n + 1) = b n := rfl

theorem chewi128ShiftedResidual_norm_le_bound
    {Ω E : Type*} [NormedAddCommGroup E] (zeta : ℕ -> Ω -> E)
    (b : ℕ -> ℝ) (hzeta_bound : ∀ n ω, ‖zeta n ω‖ ≤ b n)
    (n : ℕ) (ω : Ω) :
    ‖chewi128ShiftedResidual zeta n ω‖ ≤
      chewi128ShiftedResidualBound b n := by
  cases n with
  | zero => simp [chewi128ShiftedResidual, chewi128ShiftedResidualBound]
  | succ k => simpa using hzeta_bound k ω

theorem chewi128ShiftedResidualBound_nonneg
    (b : ℕ -> ℝ) (hb_nonneg : ∀ n, 0 ≤ b n) (n : ℕ) :
    0 ≤ chewi128ShiftedResidualBound b n := by
  cases n with
  | zero => simp
  | succ k => simpa using hb_nonneg k

theorem chewi128ShiftedResidual_norm_eq_shiftedResidualBound_norm
    {Ω E : Type*} [NormedAddCommGroup E] (zeta : ℕ -> Ω -> E)
    (n : ℕ) (ω : Ω) :
    ‖chewi128ShiftedResidual zeta n ω‖ =
      chewi128ShiftedResidualBound (fun k => ‖zeta k ω‖) n := by
  cases n with
  | zero => simp [chewi128ShiftedResidual, chewi128ShiftedResidualBound]
  | succ k => simp [chewi128ShiftedResidual, chewi128ShiftedResidualBound]

theorem chewi128ShiftedResidualBound_le_sum_range
    (b : ℕ -> ℝ) (hb_nonneg : ∀ n, 0 ≤ b n) (N : ℕ) :
    chewi128ShiftedResidualBound b N ≤ ∑ k ∈ Finset.range N, b k := by
  cases N with
  | zero => simp
  | succ n =>
      simpa using
        Finset.single_le_sum
          (s := Finset.range (n + 1)) (a := n) (f := b)
          (fun k _hk => hb_nonneg k)
          (Finset.mem_range.mpr (Nat.lt_succ_self n))

theorem chewi128_sum_Ico_shiftedResidualBound_le_sum_range
    (b : ℕ -> ℝ) (hb_nonneg : ∀ n, 0 ≤ b n) (N : ℕ) :
    (∑ k ∈ Finset.Ico 1 N, chewi128ShiftedResidualBound b k) ≤
      ∑ k ∈ Finset.range N, b k := by
  calc
    (∑ k ∈ Finset.Ico 1 N, chewi128ShiftedResidualBound b k) =
        ∑ k ∈ Finset.range (N - 1), b k := by
      rw [Finset.sum_Ico_eq_sum_range]
      refine Finset.sum_congr rfl ?_
      intro k _hk
      rw [Nat.add_comm 1 k]
      simp
    _ ≤ ∑ k ∈ Finset.range N, b k := by
      refine Finset.sum_le_sum_of_subset_of_nonneg ?_ ?_
      · intro k hk
        exact Finset.mem_range.mpr
          ((Finset.mem_range.mp hk).trans_le (Nat.sub_le N 1))
      · intro k _hk _hnot
        exact hb_nonneg k

theorem chewi128_sum_Ico_coeff_shiftedResidualBound_le_uniform_mul_sum_range
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (A Ainv : E →L[ℝ] E) (h : ℕ -> ℝ)
    (b : ℕ -> ℝ) (K : ℝ)
    (hb_nonneg : ∀ n, 0 ≤ b n) (hK_nonneg : 0 ≤ K)
    (hcoeff_bound : ∀ N k, k ∈ Finset.Ico 1 N ->
      ‖chewi123SourceNoiseCoefficient A h k N - Ainv‖ ≤ K)
    (N : ℕ) :
    (∑ k ∈ Finset.Ico 1 N,
        ‖chewi123SourceNoiseCoefficient A h k N - Ainv‖ *
          chewi128ShiftedResidualBound b k) ≤
      K * ∑ k ∈ Finset.range N, b k := by
  calc
    (∑ k ∈ Finset.Ico 1 N,
        ‖chewi123SourceNoiseCoefficient A h k N - Ainv‖ *
          chewi128ShiftedResidualBound b k) ≤
        ∑ k ∈ Finset.Ico 1 N,
          K * chewi128ShiftedResidualBound b k := by
      refine Finset.sum_le_sum fun k hk => ?_
      exact
        mul_le_mul_of_nonneg_right
          (hcoeff_bound N k hk)
          (chewi128ShiftedResidualBound_nonneg b hb_nonneg k)
    _ = K * ∑ k ∈ Finset.Ico 1 N, chewi128ShiftedResidualBound b k := by
      rw [Finset.mul_sum]
    _ ≤ K * ∑ k ∈ Finset.range N, b k :=
      mul_le_mul_of_nonneg_left
        (chewi128_sum_Ico_shiftedResidualBound_le_sum_range b hb_nonneg N)
        hK_nonneg

/--
Pointwise deterministic upper bound for the Chewi 12.8 `zeta` contribution.
The first row controls the extra scaled-noise sum and the second row controls
the endpoint-correction remainder.
-/
noncomputable def chewi128ASGDZetaContributionPointwiseBound
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (A Ainv : E →L[ℝ] E) (h : ℕ -> ℝ) (b : ℕ -> ℝ) (N : ℕ) : ℝ :=
  ‖(Real.sqrt (N : ℝ))⁻¹‖ * ‖Ainv‖ *
      ∑ k ∈ Finset.range N, b k +
    (‖(Real.sqrt (N : ℝ))⁻¹‖ * ‖Ainv‖ *
        chewi128ShiftedResidualBound b N +
      ‖(Real.sqrt (N : ℝ))⁻¹‖ *
        ∑ k ∈ Finset.Ico 1 N,
          ‖chewi123SourceNoiseCoefficient A h k N - Ainv‖ *
            chewi128ShiftedResidualBound b k)

theorem chewi128_neg_inverse_scaled_shiftedResidual_norm_le_bound
    {Ω E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (Ainv : E →L[ℝ] E) (zeta : ℕ -> Ω -> E) (b : ℕ -> ℝ)
    (hzeta_bound : ∀ n ω, ‖zeta n ω‖ ≤ b n)
    (N : ℕ) (ω : Ω) :
    ‖-Ainv (chewi127ScaledNoiseSum (chewi128ShiftedResidual zeta) N ω)‖ ≤
      ‖(Real.sqrt (N : ℝ))⁻¹‖ * ‖Ainv‖ *
        ∑ k ∈ Finset.range N, b k := by
  let c : ℝ := (Real.sqrt (N : ℝ))⁻¹
  have hsum :
      ‖∑ k ∈ Finset.range N, chewi128ShiftedResidual zeta (k + 1) ω‖ ≤
        ∑ k ∈ Finset.range N, b k := by
    calc
      ‖∑ k ∈ Finset.range N, chewi128ShiftedResidual zeta (k + 1) ω‖ ≤
          ∑ k ∈ Finset.range N, ‖chewi128ShiftedResidual zeta (k + 1) ω‖ := by
        simpa using
          norm_sum_le
            (s := Finset.range N)
            (f := fun k => chewi128ShiftedResidual zeta (k + 1) ω)
      _ ≤ ∑ k ∈ Finset.range N, b k :=
        Finset.sum_le_sum fun k _hk => by
          simpa using hzeta_bound k ω
  calc
    ‖-Ainv (chewi127ScaledNoiseSum (chewi128ShiftedResidual zeta) N ω)‖ =
        ‖Ainv (c • ∑ k ∈ Finset.range N,
          chewi128ShiftedResidual zeta (k + 1) ω)‖ := by
      simp [chewi127ScaledNoiseSum, c]
    _ ≤ ‖Ainv‖ *
        ‖c • ∑ k ∈ Finset.range N,
          chewi128ShiftedResidual zeta (k + 1) ω‖ :=
      Ainv.le_opNorm _
    _ = ‖Ainv‖ *
        (‖c‖ *
          ‖∑ k ∈ Finset.range N, chewi128ShiftedResidual zeta (k + 1) ω‖) := by
      simp [norm_smul]
    _ ≤ ‖Ainv‖ * (‖c‖ * ∑ k ∈ Finset.range N, b k) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hsum (norm_nonneg _))
        (norm_nonneg _)
    _ = ‖(Real.sqrt (N : ℝ))⁻¹‖ * ‖Ainv‖ *
        ∑ k ∈ Finset.range N, b k := by
      ring

theorem chewi128_endpoint_corrected_shiftedResidual_norm_le_bound
    {Ω E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (A Ainv : E →L[ℝ] E) (h : ℕ -> ℝ)
    (zeta : ℕ -> Ω -> E) (b : ℕ -> ℝ)
    (hzeta_bound : ∀ n ω, ‖zeta n ω‖ ≤ b n)
    (N : ℕ) (ω : Ω) :
    ‖chewi123ASGDEndpointCorrectedRemainder A Ainv h
        (fun n => chewi128ShiftedResidual zeta n ω) N‖ ≤
      ‖(Real.sqrt (N : ℝ))⁻¹‖ * ‖Ainv‖ *
          chewi128ShiftedResidualBound b N +
        ‖(Real.sqrt (N : ℝ))⁻¹‖ *
          ∑ k ∈ Finset.Ico 1 N,
            ‖chewi123SourceNoiseCoefficient A h k N - Ainv‖ *
              chewi128ShiftedResidualBound b k := by
  have hbase :=
    chewi123ASGDEndpointCorrectedRemainder_norm_le_opNorm_sum
      A Ainv h (fun n => chewi128ShiftedResidual zeta n ω) N
  refine hbase.trans (add_le_add ?_ ?_)
  · exact
      mul_le_mul_of_nonneg_left
        (chewi128ShiftedResidual_norm_le_bound zeta b hzeta_bound N ω)
        (mul_nonneg (norm_nonneg _) (norm_nonneg _))
  · refine
      mul_le_mul_of_nonneg_left
        (Finset.sum_le_sum fun k _hk => ?_)
        (norm_nonneg _)
    exact
      mul_le_mul_of_nonneg_left
        (chewi128ShiftedResidual_norm_le_bound zeta b hzeta_bound k ω)
        (norm_nonneg _)

theorem chewi128ASGDZetaContribution_norm_le_pointwiseBound
    {Ω E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (A Ainv : E →L[ℝ] E) (h : ℕ -> ℝ)
    (zeta : ℕ -> Ω -> E) (b : ℕ -> ℝ)
    (hzeta_bound : ∀ n ω, ‖zeta n ω‖ ≤ b n)
    (N : ℕ) (ω : Ω) :
    ‖chewi128ASGDZetaContribution A Ainv h zeta N ω‖ ≤
      chewi128ASGDZetaContributionPointwiseBound A Ainv h b N := by
  have hfirst :=
    chewi128_neg_inverse_scaled_shiftedResidual_norm_le_bound
      Ainv zeta b hzeta_bound N ω
  have hsecond :=
    chewi128_endpoint_corrected_shiftedResidual_norm_le_bound
      A Ainv h zeta b hzeta_bound N ω
  calc
    ‖chewi128ASGDZetaContribution A Ainv h zeta N ω‖ ≤
        ‖-Ainv (chewi127ScaledNoiseSum (chewi128ShiftedResidual zeta) N ω)‖ +
          ‖chewi123ASGDEndpointCorrectedRemainder A Ainv h
              (fun n => chewi128ShiftedResidual zeta n ω) N‖ := by
      simpa [chewi128ASGDZetaContribution] using
        norm_add_le
          (-Ainv (chewi127ScaledNoiseSum (chewi128ShiftedResidual zeta) N ω))
          (chewi123ASGDEndpointCorrectedRemainder A Ainv h
            (fun n => chewi128ShiftedResidual zeta n ω) N)
    _ ≤ chewi128ASGDZetaContributionPointwiseBound A Ainv h b N := by
      simpa [chewi128ASGDZetaContributionPointwiseBound] using
        add_le_add hfirst hsecond

theorem chewi128_neg_inverse_scaled_shiftedResidual_norm_le_sum_norm
    {Ω E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (Ainv : E →L[ℝ] E) (zeta : ℕ -> Ω -> E)
    (N : ℕ) (ω : Ω) :
    ‖-Ainv (chewi127ScaledNoiseSum (chewi128ShiftedResidual zeta) N ω)‖ ≤
      ‖(Real.sqrt (N : ℝ))⁻¹‖ * ‖Ainv‖ *
        ∑ k ∈ Finset.range N, ‖zeta k ω‖ := by
  let c : ℝ := (Real.sqrt (N : ℝ))⁻¹
  have hsum :
      ‖∑ k ∈ Finset.range N, chewi128ShiftedResidual zeta (k + 1) ω‖ ≤
        ∑ k ∈ Finset.range N, ‖zeta k ω‖ := by
    calc
      ‖∑ k ∈ Finset.range N, chewi128ShiftedResidual zeta (k + 1) ω‖ ≤
          ∑ k ∈ Finset.range N, ‖chewi128ShiftedResidual zeta (k + 1) ω‖ := by
        simpa using
          norm_sum_le
            (s := Finset.range N)
            (f := fun k => chewi128ShiftedResidual zeta (k + 1) ω)
      _ = ∑ k ∈ Finset.range N, ‖zeta k ω‖ := by
        simp
  calc
    ‖-Ainv (chewi127ScaledNoiseSum (chewi128ShiftedResidual zeta) N ω)‖ =
        ‖Ainv (c • ∑ k ∈ Finset.range N,
          chewi128ShiftedResidual zeta (k + 1) ω)‖ := by
      simp [chewi127ScaledNoiseSum, c]
    _ ≤ ‖Ainv‖ *
        ‖c • ∑ k ∈ Finset.range N,
          chewi128ShiftedResidual zeta (k + 1) ω‖ :=
      Ainv.le_opNorm _
    _ = ‖Ainv‖ *
        (‖c‖ *
          ‖∑ k ∈ Finset.range N, chewi128ShiftedResidual zeta (k + 1) ω‖) := by
      simp [norm_smul]
    _ ≤ ‖Ainv‖ *
        (‖c‖ * ∑ k ∈ Finset.range N, ‖zeta k ω‖) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hsum (norm_nonneg _))
        (norm_nonneg _)
    _ = ‖(Real.sqrt (N : ℝ))⁻¹‖ * ‖Ainv‖ *
        ∑ k ∈ Finset.range N, ‖zeta k ω‖ := by
      ring

theorem chewi128_endpoint_corrected_shiftedResidual_norm_le_sum_norm
    {Ω E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (A Ainv : E →L[ℝ] E) (h : ℕ -> ℝ)
    (zeta : ℕ -> Ω -> E) (N : ℕ) (ω : Ω) :
    ‖chewi123ASGDEndpointCorrectedRemainder A Ainv h
        (fun n => chewi128ShiftedResidual zeta n ω) N‖ ≤
      ‖(Real.sqrt (N : ℝ))⁻¹‖ * ‖Ainv‖ *
          chewi128ShiftedResidualBound (fun k => ‖zeta k ω‖) N +
        ‖(Real.sqrt (N : ℝ))⁻¹‖ *
          ∑ k ∈ Finset.Ico 1 N,
            ‖chewi123SourceNoiseCoefficient A h k N - Ainv‖ *
              chewi128ShiftedResidualBound (fun j => ‖zeta j ω‖) k := by
  simpa [chewi128ShiftedResidual_norm_eq_shiftedResidualBound_norm] using
    chewi123ASGDEndpointCorrectedRemainder_norm_le_opNorm_sum
      A Ainv h (fun n => chewi128ShiftedResidual zeta n ω) N

theorem chewi128ASGDZetaContribution_norm_le_source_row_of_uniform_coeff_bound
    {Ω E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (A Ainv : E →L[ℝ] E) (h : ℕ -> ℝ)
    (zeta : ℕ -> Ω -> E) (K : ℝ)
    (hK_nonneg : 0 ≤ K)
    (hcoeff_bound : ∀ N k, k ∈ Finset.Ico 1 N ->
      ‖chewi123SourceNoiseCoefficient A h k N - Ainv‖ ≤ K)
    (N : ℕ) (ω : Ω) :
    ‖chewi128ASGDZetaContribution A Ainv h zeta N ω‖ ≤
      (2 * ‖Ainv‖ + K) *
        (‖(Real.sqrt (N : ℝ))⁻¹‖ *
          ∑ k ∈ Finset.range N, ‖zeta k ω‖) := by
  let b : ℕ -> ℝ := fun k => ‖zeta k ω‖
  let c : ℝ := ‖(Real.sqrt (N : ℝ))⁻¹‖
  let S : ℝ := ∑ k ∈ Finset.range N, b k
  have hb_nonneg : ∀ n, 0 ≤ b n := fun n => norm_nonneg _
  have hfirst :
      ‖-Ainv (chewi127ScaledNoiseSum (chewi128ShiftedResidual zeta) N ω)‖ ≤
        c * ‖Ainv‖ * S := by
    simpa [b, c, S] using
      chewi128_neg_inverse_scaled_shiftedResidual_norm_le_sum_norm
        Ainv zeta N ω
  have hsecond :
      ‖chewi123ASGDEndpointCorrectedRemainder A Ainv h
          (fun n => chewi128ShiftedResidual zeta n ω) N‖ ≤
        c * ‖Ainv‖ * chewi128ShiftedResidualBound b N +
          c *
            ∑ k ∈ Finset.Ico 1 N,
              ‖chewi123SourceNoiseCoefficient A h k N - Ainv‖ *
                chewi128ShiftedResidualBound b k := by
    simpa [b, c] using
      chewi128_endpoint_corrected_shiftedResidual_norm_le_sum_norm
        A Ainv h zeta N ω
  have hshift :
      chewi128ShiftedResidualBound b N ≤ S :=
    chewi128ShiftedResidualBound_le_sum_range b hb_nonneg N
  have hcoeff_sum :
      (∑ k ∈ Finset.Ico 1 N,
          ‖chewi123SourceNoiseCoefficient A h k N - Ainv‖ *
            chewi128ShiftedResidualBound b k) ≤ K * S :=
    chewi128_sum_Ico_coeff_shiftedResidualBound_le_uniform_mul_sum_range
      A Ainv h b K hb_nonneg hK_nonneg hcoeff_bound N
  have hsecond_to_row :
      c * ‖Ainv‖ * chewi128ShiftedResidualBound b N +
          c *
            ∑ k ∈ Finset.Ico 1 N,
              ‖chewi123SourceNoiseCoefficient A h k N - Ainv‖ *
                chewi128ShiftedResidualBound b k ≤
        c * ‖Ainv‖ * S + c * (K * S) := by
    exact
      add_le_add
        (mul_le_mul_of_nonneg_left hshift
          (mul_nonneg (norm_nonneg _) (norm_nonneg _)))
        (mul_le_mul_of_nonneg_left hcoeff_sum (norm_nonneg _))
  calc
    ‖chewi128ASGDZetaContribution A Ainv h zeta N ω‖ ≤
        ‖-Ainv (chewi127ScaledNoiseSum (chewi128ShiftedResidual zeta) N ω)‖ +
          ‖chewi123ASGDEndpointCorrectedRemainder A Ainv h
              (fun n => chewi128ShiftedResidual zeta n ω) N‖ := by
      simpa [chewi128ASGDZetaContribution] using
        norm_add_le
          (-Ainv (chewi127ScaledNoiseSum (chewi128ShiftedResidual zeta) N ω))
          (chewi123ASGDEndpointCorrectedRemainder A Ainv h
            (fun n => chewi128ShiftedResidual zeta n ω) N)
    _ ≤ c * ‖Ainv‖ * S + (c * ‖Ainv‖ * S + c * (K * S)) :=
      add_le_add hfirst (hsecond.trans hsecond_to_row)
    _ = (2 * ‖Ainv‖ + K) * (c * S) := by
      ring

/--
Source-facing stochastic-o handoff for the Chewi 12.8 residual.  A later packet
will discharge the displayed deterministic decay from the textbook's
`(sqrt N)^{-1} sum E ||zeta_k|| -> 0` estimate and Taylor/Hessian bounds.
-/
theorem chewi128ASGDZetaContribution_tendstoInMeasure_zero_of_pointwise_bound
    {Ω E : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (A Ainv : E →L[ℝ] E) (h : ℕ -> ℝ)
    (zeta : ℕ -> Ω -> E) (b : ℕ -> ℝ)
    (hzeta_bound : ∀ n ω, ‖zeta n ω‖ ≤ b n)
    (hbound_tendsto :
      Tendsto
        (chewi128ASGDZetaContributionPointwiseBound A Ainv h b)
        atTop (𝓝 0)) :
