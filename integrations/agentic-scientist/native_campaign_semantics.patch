+    """Run one optional source-bound AI review, without retrying or inferring proof."""
+    python = environment.get("AI_STATISTICIAN_API_PYTHON")
+    entrypoint = environment.get("AI_STATISTICIAN_API_ENTRYPOINT")
+    model = environment.get("AI_STATISTICIAN_API_MODEL")
