        (norm_nonneg _)

/--
Power-sum version of the Chewi 12.8 residual handoff.  After Taylor/moment
estimates bound each `E ||zeta_k||` by a power row, it is enough to show that
the corresponding finite sum is eventually `O(N^beta)` for some
`beta < 1/2`.
-/
theorem chewi128ASGDZetaContribution_tendstoInMeasure_zero_of_zeta_l1_rate_and_power_sum_bound
    {Ω E : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    [IsFiniteMeasure P]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (A Ainv : E →L[ℝ] E) (h : ℕ -> ℝ)
    (zeta : ℕ -> Ω -> E) (K C D gamma beta : ℝ)
    (hK_nonneg : 0 ≤ K)
    (hC_nonneg : 0 ≤ C)
    (hbeta_lt : beta < (1 : ℝ) / 2)
    (hcoeff_bound : ∀ N k, k ∈ Finset.Ico 1 N ->
      ‖chewi123SourceNoiseCoefficient A h k N - Ainv‖ ≤ K)
    (hzeta_int : ∀ k, Integrable (fun ω => ‖zeta k ω‖) P)
    (hZetaContribution_int :
      ∀ N,
        Integrable
          (fun ω => ‖chewi128ASGDZetaContribution A Ainv h zeta N ω‖) P)
    (hzeta_l1_bound :
      ∀ k, ∫ ω, ‖zeta k ω‖ ∂P ≤
        C * (((k + 1 : ℕ) : ℝ) ^ (-gamma)))
    (hpower_sum_bound :
      ∀ᶠ N in atTop,
        (∑ k ∈ Finset.range N,
            C * (((k + 1 : ℕ) : ℝ) ^ (-gamma))) ≤
          D * (N : ℝ) ^ beta) :
    TendstoInMeasure P
      (fun N ω => chewi128ASGDZetaContribution A Ainv h zeta N ω)
      atTop (fun _ => 0) := by
  have hpower_row :
      Tendsto
        (fun N : ℕ =>
          ‖(Real.sqrt (N : ℝ))⁻¹‖ *
            ∑ k ∈ Finset.range N,
              C * (((k + 1 : ℕ) : ℝ) ^ (-gamma)))
        atTop (𝓝 0) := by
    refine
      chewi128_sqrt_inv_row_tendsto_zero_of_power_bound
        (fun N : ℕ =>
          ∑ k ∈ Finset.range N,
            C * (((k + 1 : ℕ) : ℝ) ^ (-gamma)))
        hbeta_lt ?_ hpower_sum_bound
    exact Eventually.of_forall fun N =>
      Finset.sum_nonneg fun k _hk =>
        mul_nonneg hC_nonneg
          (Real.rpow_nonneg (Nat.cast_nonneg (k + 1)) (-gamma))
  exact
    chewi128ASGDZetaContribution_tendstoInMeasure_zero_of_zeta_l1_rate_and_uniform_coeff_bound
      A Ainv h zeta K C gamma hK_nonneg hcoeff_bound hzeta_int
      hZetaContribution_int hzeta_l1_bound hpower_row

/--
Textbook-shaped Chewi 12.8 residual handoff for the `gamma > 1/2` source
regime: a per-step L1 Taylor-residual rate `E ||zeta_k|| ≤ C (k+1)^(-gamma)`
is enough to make the ASGD `zeta` contribution vanish in measure.
-/
theorem chewi128ASGDZetaContribution_tendstoInMeasure_zero_of_zeta_l1_rate_and_gamma_gt_half
    {Ω E : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    [IsFiniteMeasure P]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (A Ainv : E →L[ℝ] E) (h : ℕ -> ℝ)
    (zeta : ℕ -> Ω -> E) (K C gamma : ℝ)
    (hK_nonneg : 0 ≤ K)
    (hC_nonneg : 0 ≤ C)
    (hgamma_half : (1 : ℝ) / 2 < gamma)
    (hgamma_lt_one : gamma < 1)
    (hcoeff_bound : ∀ N k, k ∈ Finset.Ico 1 N ->
      ‖chewi123SourceNoiseCoefficient A h k N - Ainv‖ ≤ K)
    (hzeta_int : ∀ k, Integrable (fun ω => ‖zeta k ω‖) P)
    (hZetaContribution_int :
      ∀ N,
        Integrable
          (fun ω => ‖chewi128ASGDZetaContribution A Ainv h zeta N ω‖) P)
    (hzeta_l1_bound :
      ∀ k, ∫ ω, ‖zeta k ω‖ ∂P ≤
        C * (((k + 1 : ℕ) : ℝ) ^ (-gamma))) :
    TendstoInMeasure P
      (fun N ω => chewi128ASGDZetaContribution A Ainv h zeta N ω)
      atTop (fun _ => 0) := by
  exact
    chewi128ASGDZetaContribution_tendstoInMeasure_zero_of_zeta_l1_rate_and_uniform_coeff_bound
      A Ainv h zeta K C gamma hK_nonneg hcoeff_bound hzeta_int
      hZetaContribution_int hzeta_l1_bound
      (chewi128_power_source_row_tendsto_zero_of_gamma_gt_half
        C gamma hC_nonneg hgamma_half hgamma_lt_one)

/--
L1 source-rate handoff from the pointwise Taylor/Hessian quadratic remainder
bound and Chewi's second-moment rate for the iterate error.
-/
theorem chewi128_zeta_l1_bound_of_pointwise_quadratic_and_moment_rate
    {Ω E : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (zeta delta : ℕ -> Ω -> E) (C0 Ctheta gamma : ℝ)
    (hC0_nonneg : 0 ≤ C0)
    (hzeta_int : ∀ k, Integrable (fun ω => ‖zeta k ω‖) P)
    (hdelta_sq_int : ∀ k, Integrable (fun ω => ‖delta k ω‖ ^ (2 : ℕ)) P)
    (hzeta_point :
      ∀ k,
        (fun ω => ‖zeta k ω‖) ≤ᵐ[P]
          fun ω => C0 * ‖delta k ω‖ ^ (2 : ℕ))
    (hmoment_rate :
      ∀ k, ∫ ω, ‖delta k ω‖ ^ (2 : ℕ) ∂P ≤
        Ctheta * (((k + 1 : ℕ) : ℝ) ^ (-gamma)))
    (k : ℕ) :
    ∫ ω, ‖zeta k ω‖ ∂P ≤
      (C0 * Ctheta) * (((k + 1 : ℕ) : ℝ) ^ (-gamma)) := by
  have hdom_int :
      Integrable (fun ω => C0 * ‖delta k ω‖ ^ (2 : ℕ)) P :=
    (hdelta_sq_int k).const_mul C0
  calc
    ∫ ω, ‖zeta k ω‖ ∂P
        ≤ ∫ ω, C0 * ‖delta k ω‖ ^ (2 : ℕ) ∂P :=
          integral_mono_ae (hzeta_int k) hdom_int (hzeta_point k)
    _ = C0 * ∫ ω, ‖delta k ω‖ ^ (2 : ℕ) ∂P := by
          rw [integral_const_mul]
    _ ≤ C0 * (Ctheta * (((k + 1 : ℕ) : ℝ) ^ (-gamma))) :=
          mul_le_mul_of_nonneg_left (hmoment_rate k) hC0_nonneg
    _ = (C0 * Ctheta) * (((k + 1 : ℕ) : ℝ) ^ (-gamma)) := by ring

/--
Chewi 12.8 residual handoff from the Taylor/Hessian quadratic pointwise bound
and the iterate second-moment rate.  This removes the separate
`E ||zeta_k|| <= C (k+1)^(-gamma)` interface when the caller already has the
standard Taylor and moment-rate hypotheses.
-/
theorem chewi128ASGDZetaContribution_tendstoInMeasure_zero_of_pointwise_quadratic_moment_rate_and_gamma_gt_half
    {Ω E : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    [IsFiniteMeasure P]
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (A Ainv : E →L[ℝ] E) (h : ℕ -> ℝ)
    (zeta delta : ℕ -> Ω -> E) (K C0 Ctheta gamma : ℝ)
    (hK_nonneg : 0 ≤ K)
    (hC0_nonneg : 0 ≤ C0)
    (hCtheta_nonneg : 0 ≤ Ctheta)
    (hgamma_half : (1 : ℝ) / 2 < gamma)
    (hgamma_lt_one : gamma < 1)
    (hcoeff_bound : ∀ N k, k ∈ Finset.Ico 1 N ->
      ‖chewi123SourceNoiseCoefficient A h k N - Ainv‖ ≤ K)
    (hzeta_int : ∀ k, Integrable (fun ω => ‖zeta k ω‖) P)
    (hdelta_sq_int : ∀ k, Integrable (fun ω => ‖delta k ω‖ ^ (2 : ℕ)) P)
    (hZetaContribution_int :
      ∀ N,
        Integrable
          (fun ω => ‖chewi128ASGDZetaContribution A Ainv h zeta N ω‖) P)
    (hzeta_point :
      ∀ k,
        (fun ω => ‖zeta k ω‖) ≤ᵐ[P]
          fun ω => C0 * ‖delta k ω‖ ^ (2 : ℕ))
    (hmoment_rate :
      ∀ k, ∫ ω, ‖delta k ω‖ ^ (2 : ℕ) ∂P ≤
        Ctheta * (((k + 1 : ℕ) : ℝ) ^ (-gamma))) :
    TendstoInMeasure P
      (fun N ω => chewi128ASGDZetaContribution A Ainv h zeta N ω)
      atTop (fun _ => 0) := by
  refine
    chewi128ASGDZetaContribution_tendstoInMeasure_zero_of_zeta_l1_rate_and_gamma_gt_half
      A Ainv h zeta K (C0 * Ctheta) gamma hK_nonneg
      (mul_nonneg hC0_nonneg hCtheta_nonneg)
      hgamma_half hgamma_lt_one hcoeff_bound hzeta_int
      hZetaContribution_int ?_
  intro k
  exact
    chewi128_zeta_l1_bound_of_pointwise_quadratic_and_moment_rate
      zeta delta C0 Ctheta gamma hC0_nonneg hzeta_int hdelta_sq_int
      hzeta_point hmoment_rate k

/--
Endpoint-corrected decomposition for the general ASGD recursion.  The first
remainder is the usual quadratic-ASGD endpoint correction for the martingale
increments, and the second is the deterministic Taylor/Hessian residual
contribution.
-/
theorem chewi128_general_sqrt_average_delta_endpoint_corrected_decomposition_ae
    {Ω E : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (A Ainv : E →L[ℝ] E) (h : ℕ -> ℝ)
    (delta xi zeta : ℕ -> Ω -> E)
    (hrec : ∀ n ω,
      delta (n + 1) ω =
        chewi123QuadraticStepMap (h (n + 1)) A (delta n ω) -
          h (n + 1) • (xi (n + 1) ω + zeta n ω))
    (N : ℕ) :
    (fun ω =>
        (-Ainv (chewi127ScaledNoiseSum xi N ω) +
            chewi123ASGDInitialTerm A h (delta 0 ω) N) +
          (chewi123ASGDEndpointCorrectedRemainder A Ainv h
              (fun n => xi n ω) N +
            chewi128ASGDZetaContribution A Ainv h zeta N ω))
      =ᵐ[P]
    (fun ω => chewi123ScaledAverageDelta (fun n => delta n ω) N) := by
  refine ae_of_all _ fun ω => ?_
  let shifted : ℕ -> E := fun n => chewi128ShiftedResidual zeta n ω
  let perturbed : ℕ -> E := fun n => chewi128PerturbedNoise xi zeta n ω
  have hrecPerturbed :
      ∀ n,
        delta (n + 1) ω =
          chewi123QuadraticStepMap (h (n + 1)) A (delta n ω) -
            h (n + 1) • perturbed (n + 1) := by
    intro n
    simpa [perturbed, chewi128PerturbedNoise] using hrec n ω
  have hdecomp :=
    chewi123_quadratic_sqrt_average_delta_endpoint_corrected_decomposition
      A Ainv h (fun n => delta n ω) perturbed hrecPerturbed N
  have hnoise :
      chewi127ScaledNoiseSum (fun n ω => xi n ω + chewi128ShiftedResidual zeta n ω) N ω =
        chewi127ScaledNoiseSum xi N ω +
          chewi127ScaledNoiseSum (chewi128ShiftedResidual zeta) N ω :=
    chewi127ScaledNoiseSum_add xi (chewi128ShiftedResidual zeta) N ω
  have hrem :
      chewi123ASGDEndpointCorrectedRemainder A Ainv h perturbed N =
        chewi123ASGDEndpointCorrectedRemainder A Ainv h (fun n => xi n ω) N +
          chewi123ASGDEndpointCorrectedRemainder A Ainv h shifted N := by
    simpa [perturbed, shifted, chewi128PerturbedNoise] using
      chewi123ASGDEndpointCorrectedRemainder_add
        A Ainv h (fun n => xi n ω) shifted N
  calc
    (-Ainv (chewi127ScaledNoiseSum xi N ω) +
          chewi123ASGDInitialTerm A h (delta 0 ω) N) +
        (chewi123ASGDEndpointCorrectedRemainder A Ainv h
            (fun n => xi n ω) N +
          chewi128ASGDZetaContribution A Ainv h zeta N ω)
        =
      (-Ainv (chewi127ScaledNoiseSum
            (fun n ω => xi n ω + chewi128ShiftedResidual zeta n ω) N ω) +
          chewi123ASGDInitialTerm A h (delta 0 ω) N) +
        chewi123ASGDEndpointCorrectedRemainder A Ainv h perturbed N := by
          rw [hnoise, hrem]
          simp [chewi128ASGDZetaContribution, shifted]
          module
    _ = chewi123ScaledAverageDelta (fun n => delta n ω) N := hdecomp

/--
Chewi Theorem 12.8 source bridge from the general ASGD recursion to the
compiled martingale CLT and quadratic ASGD endpoint.  The remaining analytic
obligation is exactly the residual contribution `zetaContribution = o_P(1)`.
-/
theorem chewi128_asgd_limit_package_of_martingale_certificate_endpoint_corrected
    {Ω Ω' E : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    [IsProbabilityMeasure P] [MeasurableSpace Ω'] {Q : Measure Ω'}
    [IsProbabilityMeasure Q]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [MeasurableSpace E]
    [CompleteSpace E] [SecondCountableTopology E] [BorelSpace E]
    [OpensMeasurableSpace E]
    (C : Chewi127MartingaleCLTCertificate Ω Ω' E P Q)
    (A Ainv : E →L[ℝ] E) (h : ℕ -> ℝ)
    (delta xi zeta : ℕ -> Ω -> E)
    (hrec : ∀ n ω,
      delta (n + 1) ω =
        chewi123QuadraticStepMap (h (n + 1)) A (delta n ω) -
          h (n + 1) • (xi (n + 1) ω + zeta n ω))
    (hInitial : TendstoInMeasure P
      (fun N ω => chewi123ASGDInitialTerm A h (delta 0 ω) N)
      atTop (fun _ => 0))
    (hRemainder : TendstoInMeasure P
      (fun N ω =>
        chewi123ASGDEndpointCorrectedRemainder A Ainv h
          (fun n => xi n ω) N)
      atTop (fun _ => 0))
    (hZeta : TendstoInMeasure P
      (fun N ω => chewi128ASGDZetaContribution A Ainv h zeta N ω)
      atTop (fun _ => 0))
    (hInitial_meas : ∀ N,
      AEMeasurable (fun ω => chewi123ASGDInitialTerm A h (delta 0 ω) N) P)
    (hRemainder_meas : ∀ N,
      AEMeasurable
        (fun ω =>
          chewi123ASGDEndpointCorrectedRemainder A Ainv h
            (fun n => xi n ω) N) P)
    (hZeta_meas : ∀ N,
      AEMeasurable
        (fun ω => chewi128ASGDZetaContribution A Ainv h zeta N ω) P)
    (hNoise_eq : ∀ N, C.noiseScaled N =ᵐ[P] chewi127ScaledNoiseSum xi N) :
    TendstoInDistribution
        (fun N ω => chewi123ScaledAverageDelta (fun n => delta n ω) N)
        atTop (fun ω => -Ainv (C.Z ω)) (fun _ => P) Q ∧
      ProbabilityTheory.HasGaussianLaw (fun ω => -Ainv (C.Z ω)) Q ∧
      ∀ L K : StrongDual ℝ E,
        ProbabilityTheory.covarianceBilinDual
            (Q.map fun ω => -Ainv (C.Z ω)) L K =
          vaart1998_inverseDerivativeCovarianceFunctional (-Ainv)
            (fun L0 K0 =>
              ProbabilityTheory.covarianceBilinDual (Q.map C.Z) L0 K0) L K := by
  let quadraticApprox : ℕ -> Ω -> E := fun N ω =>
    (-Ainv (C.noiseScaled N ω) +
        chewi123ASGDInitialTerm A h (delta 0 ω) N) +
      chewi123ASGDEndpointCorrectedRemainder A Ainv h (fun n => xi n ω) N
  have hquad_package :
      TendstoInDistribution quadraticApprox atTop
          (fun ω => -Ainv (C.Z ω)) (fun _ => P) Q ∧
        ProbabilityTheory.HasGaussianLaw (fun ω => -Ainv (C.Z ω)) Q ∧
        ∀ L K : StrongDual ℝ E,
          ProbabilityTheory.covarianceBilinDual
              (Q.map fun ω => -Ainv (C.Z ω)) L K =
            vaart1998_inverseDerivativeCovarianceFunctional (-Ainv)
              (fun L0 K0 =>
                ProbabilityTheory.covarianceBilinDual (Q.map C.Z) L0 K0) L K := by
    refine
      chewi123_asgd_limit_package_of_martingale_certificate
        (C := C) (Ainv := Ainv)
        (scaledAverage := quadraticApprox)
        (initial := fun N ω => chewi123ASGDInitialTerm A h (delta 0 ω) N)
        (remainder := fun N ω =>
          chewi123ASGDEndpointCorrectedRemainder A Ainv h
            (fun n => xi n ω) N)
        hInitial hRemainder hInitial_meas hRemainder_meas ?_
    intro N
    exact ae_of_all _ fun ω => by simp [quadraticApprox]
  have hwith_zeta :
      TendstoInDistribution
        (fun N ω =>
          quadraticApprox N ω +
            chewi128ASGDZetaContribution A Ainv h zeta N ω)
        atTop (fun ω => -Ainv (C.Z ω)) (fun _ => P) Q := by
    have hmain :=
      hquad_package.1.add_of_tendstoInMeasure_const
        (Y := fun N ω => chewi128ASGDZetaContribution A Ainv h zeta N ω)
        (c := (0 : E)) hZeta hZeta_meas
    simpa using hmain
  refine
    ⟨TendstoInDistribution.congr ?_ (ae_eq_refl _) hwith_zeta,
      hquad_package.2.1, hquad_package.2.2⟩
  intro N
  filter_upwards [hNoise_eq N,
    chewi128_general_sqrt_average_delta_endpoint_corrected_decomposition_ae
      (P := P) A Ainv h delta xi zeta hrec N] with ω hnoise hdecomp
  simpa [quadraticApprox, hnoise, add_assoc] using hdecomp

/--
Source-facing Chewi Theorem 12.8 bridge from the non-circular bounded
martingale CLT core.  All martingale-CLT and quadratic-ASGD endpoint plumbing
is discharged; the remaining theorem-specific analytic assumption is that the
Taylor/Hessian residual contribution is `o_P(1)`.
-/
theorem Chewi127BoundedMartingaleCharFunCLTCore.asgd_general_limit_package_endpoint_corrected
    {Ω Ω' E : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω}
    [IsProbabilityMeasure P] [MeasurableSpace Ω'] {Q : Measure Ω'}
    [IsProbabilityMeasure Q]
    [NormedAddCommGroup E] [NormedSpace ℝ E] [MeasurableSpace E]
    [CompleteSpace E] [SecondCountableTopology E] [BorelSpace E]
    [OpensMeasurableSpace E]
    (S : Chewi127BoundedMartingaleCharFunCLTCore Ω Ω' E P Q)
    (A Ainv : E →L[ℝ] E) (h : ℕ -> ℝ)
    (delta zeta : ℕ -> Ω -> E)
    (hrec : ∀ n ω,
      delta (n + 1) ω =
        chewi123QuadraticStepMap (h (n + 1)) A (delta n ω) -
          h (n + 1) • (S.martingale.xi (n + 1) ω + zeta n ω))
    (hInitial : TendstoInMeasure P
      (fun N ω => chewi123ASGDInitialTerm A h (delta 0 ω) N)
      atTop (fun _ => 0))
    (hRemainder : TendstoInMeasure P
      (fun N ω =>
        chewi123ASGDEndpointCorrectedRemainder A Ainv h
          (fun n => S.martingale.xi n ω) N)
      atTop (fun _ => 0))
    (hZeta : TendstoInMeasure P
      (fun N ω => chewi128ASGDZetaContribution A Ainv h zeta N ω)
      atTop (fun _ => 0))
    (hInitial_meas : ∀ N,
      AEMeasurable (fun ω => chewi123ASGDInitialTerm A h (delta 0 ω) N) P)
    (hRemainder_meas : ∀ N,
      AEMeasurable
        (fun ω =>
          chewi123ASGDEndpointCorrectedRemainder A Ainv h
            (fun n => S.martingale.xi n ω) N) P)
    (hZeta_meas : ∀ N,
      AEMeasurable
        (fun ω => chewi128ASGDZetaContribution A Ainv h zeta N ω) P) :
    TendstoInDistribution
        (fun N ω => chewi123ScaledAverageDelta (fun n => delta n ω) N)
        atTop (fun ω => -Ainv (S.Z ω)) (fun _ => P) Q ∧
      ProbabilityTheory.HasGaussianLaw (fun ω => -Ainv (S.Z ω)) Q ∧
      ∀ L K : StrongDual ℝ E,
        ProbabilityTheory.covarianceBilinDual
            (Q.map fun ω => -Ainv (S.Z ω)) L K =
          vaart1998_inverseDerivativeCovarianceFunctional (-Ainv)
            (fun L0 K0 =>
              ProbabilityTheory.covarianceBilinDual (Q.map S.Z) L0 K0) L K := by
  let C : Chewi127MartingaleCLTCertificate Ω Ω' E P Q :=
    S.toMartingaleCLTCertificate_of_uniform_bound_no_factor_bound
  simpa [C,
    Chewi127BoundedMartingaleCharFunCLTCore.toMartingaleCLTCertificate_of_uniform_bound_no_factor_bound,
    Chewi127BoundedMartingaleCharFunCLTSource.toMartingaleCLTCertificate,
    Chewi127BoundedMartingaleCharFunCLTSource.toBoundedMartingaleCLTSource,
    Chewi127BoundedMartingaleCLTSource.toMartingaleCLTCertificate,
    Chewi127BoundedMartingaleCLTSource.toProjectedBridge,
    Chewi127ProjectedMartingaleCLTBridge.toMartingaleCLTCertificate] using
    chewi128_asgd_limit_package_of_martingale_certificate_endpoint_corrected
      (C := C) A Ainv h delta S.martingale.xi zeta hrec
      hInitial hRemainder hZeta hInitial_meas hRemainder_meas hZeta_meas
      (fun _ => ae_of_all _ fun _ => rfl)

