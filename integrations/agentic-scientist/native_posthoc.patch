diff --git a/src/investigation/harness_incumbent.py b/src/investigation/harness_incumbent.py
index 4fa81b9..af68038 100644
--- a/src/investigation/harness_incumbent.py
+++ b/src/investigation/harness_incumbent.py
@@ -19,6 +19,38 @@ from .program_spec import entrypoint_relpath_from_spec, load_program_spec
 _MAX_ARTIFACT_BYTES = 1024 * 1024
 
 
+def native_public_outputs(task_dir: Path) -> list[dict[str, str]]:
+    """Prospective output access uses the existing scientific-evidence descriptor."""
+    import runpy
+
+    path = task_dir / "public_outputs.json"
+    if not path.exists() and not path.is_symlink():
+        return []
+    _file_digest(path)
+    if path.stat().st_size > _MAX_ARTIFACT_BYTES:
+        raise ValueError("public output declaration exceeds size limit")
+    outputs = json.loads(path.read_text())
+    schema_path = Path(__file__).resolve().parents[1] / "agents/skills/scientific-evidence/scripts/scientific_evidence.py"
+    schema = runpy.run_path(str(schema_path))["artifact_descriptor_schema"]()
+    if not isinstance(outputs, list) or not outputs:
+        raise ValueError("public outputs must be a nonempty descriptor list")
+    names = set()
+    for item in outputs:
+        if (not isinstance(item, dict) or not set(schema["required"]) <= set(item)
+            or not set(item) <= set(schema["properties"])
+            or not all(isinstance(value, str) and value for value in item.values())
+            or item["kind"] not in schema["properties"]["kind"]["enum"]):
+            raise ValueError("invalid scientific-evidence artifact descriptor")
+        name = item["path"]
+        relative = Path(name)
+        if (not relative.parts or relative.is_absolute() or relative.as_posix() != name
+            or any(part.startswith(".") or any(c in part for c in "*?[]") for part in relative.parts)
+            or name in names):
+            raise ValueError("public outputs require unique explicit relative file paths")
+        names.add(name)
+    return outputs
+
+
 def _json_digest(value: object) -> str:
     return hashlib.sha256(json.dumps(value, sort_keys=True, allow_nan=False).encode()).hexdigest()
 
@@ -120,6 +152,16 @@ def read_native_evaluation(
         and manifest.get("evidence_records") == native_evidence_identity(program_dir, source_records=manifest["source_records"])
     ):
         raise ValueError(f"missing, malformed or stale native evaluation: {program_dir}")
+    declared = native_public_outputs(program_dir.parent)
+    if manifest.get("public_outputs", []) != declared:
+        raise ValueError("native public output declaration changed")
+    if declared and manifest.get("public_task_sha256") != _file_digest(program_dir.parent / "task.md"):
+        raise ValueError("native public task changed")
+    for item in declared:
+        name = item["path"]
+        if (name in manifest["source_records"] or name not in manifest["evidence_records"]
+            or (item.get("sha256") and item["sha256"] != manifest["evidence_records"][name])):
+            raise ValueError("declared public output is missing, stale or a source input")
     status = _read_harness_json(program_dir / "rubric_status.json")
     if status != _read_harness_json(program_dir.parent / "rubric_status.json"):
         raise ValueError("native root and candidate rubric status disagree")
